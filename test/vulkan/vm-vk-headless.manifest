[libos]
entrypoint = "/vk-headless"

[sys.stack]
size = "32M"

[loader]
insecure__use_host_env = true
insecure__use_cmdline_argv = true
log_level = "error"
entrypoint = "file:/root/.local/gramine-vm/lib/x86_64-linux-gnu/gramine/libsysdb.so"

[loader.env]
LD_LIBRARY_PATH = "/lib:/usr/lib:/usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu"
LD_PRELOAD = "./libgraphics.so:/vk-session-shim.so"
DISPLAY = "2:0"
IVSHMEM_GRAMINE_VM = "1"
GLIBC_TUNABLES = "glibc.pthread.rseq=0"
GBM_BACKEND = "dri"
EGL_GRAMINE = "1"
EGL_SHARED_INPUT = "0"
EGL_DISCRETE = "0"
EGL_SYSCALL_LOG = "0"
EGL_IOCTL_LOG = "0"

[vm.net]
direct_vsock_ports = [
    6000,
]

[[fs.mounts]]
path = "/vk-headless"
uri = "file:vk-headless"

[[fs.mounts]]
path = "/libgraphics.so"
uri = "file:/root/.local/gramine-vm/lib/x86_64-linux-gnu/gramine/libgraphics.so"

[[fs.mounts]]
path = "/vk-session-shim.so"
uri = "file:vk-session-shim.so"

[[fs.mounts]]
path = "/usr"
type = "chroot"
uri = "file:/usr"

[[fs.mounts]]
path = "/etc/ld.so.cache"
uri = "file:/etc/ld.so.cache"

[[fs.mounts]]
path = "/etc/vulkan"
type = "chroot"
uri = "file:/etc/vulkan"

[[fs.mounts]]
path = "/sys"
type = "chroot"
uri = "file:/sys"

[[fs.mounts]]
path = "/sys/dev"
type = "chroot"
uri = "file:/sys/dev"

[[fs.mounts]]
path = "/sys/devices"
type = "chroot"
uri = "file:/sys/devices"

[[fs.mounts]]
path = "/sys/bus/pci"
type = "chroot"
uri = "file:/sys/bus/pci"

[[fs.mounts]]
path = "/root/.cache"
type = "chroot"
uri = "file:/root/.cache"

[sgx]
trusted_files = [
    { uri = "file:/root/.local/gramine-vm/lib/x86_64-linux-gnu/gramine/libsysdb.so" },
]
max_threads = 4
isvprodid = 0
isvsvn = 0
remote_attestation = "none"
debug = false
enable_stats = false
edmm_enable = false
enclave_size = "256M"
use_exinfo = false

[sgx.cpu_features]
avx = "unspecified"
avx512 = "unspecified"
amx = "unspecified"
mpx = "disabled"
pkru = "disabled"

#version 450
// out[i] = in[i] * 3 + 1, in place
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Data { uint v[]; } data;
layout(push_constant) uniform PC { uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n)
        data.v[i] = data.v[i] * 3u + 1u;
}

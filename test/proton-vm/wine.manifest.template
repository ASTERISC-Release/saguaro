# GE-Proton's 64-bit Wine under gramine-direct / gramine-vm (phase 0 (d) of
# Documentation/devel/proton-vm/PLAN.md): the cheapest end-to-end try, no Gramine changes.
# The entry point is the `wine` loader itself (WINELOADERNOEXEC=1 stops it from re-executing
# through wine-preloader, a static binary that maps ld.so by hand); the Proton files and the prefix
# that `proton run` created natively are reached through the host paths (virtiofs root in the VM).
# esync (eventfd), fsync (futex_waitv) and ntsync (/dev/ntsync) are off unless -Dsync=1: the
# wineserver fallback is the path that needs the fewest host features.
libos.entrypoint = "{{ proton }}/files/lib/wine/x86_64-unix/wine"
loader.log_level = "{{ log_level }}"
loader.insecure__use_cmdline_argv = true
loader.env.LD_LIBRARY_PATH = "{{ proton }}/files/lib:{{ proton }}/files/lib64:/lib:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu"
loader.env.PATH = "{{ proton }}/files/bin:/usr/bin:/bin"
loader.env.HOME = "/home/user"
loader.env.USER = "user"
loader.env.TMPDIR = "/tmp"
loader.env.WINEPREFIX = "{{ prefix }}"
loader.env.WINEDLLPATH = "{{ proton }}/files/lib/wine/x86_64-unix:{{ proton }}/files/lib/wine/i386-unix"
loader.env.WINELOADERNOEXEC = "1"
loader.env.WINEDEBUG = "{{ winedebug }}"
loader.env.WINEESYNC = "{{ sync }}"
loader.env.WINEFSYNC = "{{ sync }}"
loader.env.WINENTSYNC = "{{ sync }}"
loader.env.WINEDLLOVERRIDES = "d3d11,d3d10core,d3d9,dxgi,d3d12,d3d12core=n;winemenubuilder.exe=d"
loader.env.DISPLAY = ""
sys.experimental__multiprocess = true
sys.insecure__allow_eventfd = true
sys.stack.size = "8M"
sys.enable_sigterm_injection = true
fs.mounts = [
  { path = "/lib", uri = "file:{{ gramine.runtimedir() }}" },
  { path = "/lib/x86_64-linux-gnu", uri = "file:/lib/x86_64-linux-gnu" },
  { path = "/usr", uri = "file:/usr" },
  { path = "/bin", uri = "file:/bin" },
  { path = "/etc", uri = "file:/etc" },
  { path = "{{ proton }}", uri = "file:{{ proton }}" },
  { path = "{{ prefix }}", uri = "file:{{ prefix }}" },
  { path = "{{ tests }}", uri = "file:{{ tests }}" },
  { path = "/tmp", uri = "file:{{ work }}/tmp" },
  { path = "/home/user", uri = "file:{{ work }}/home" },
  { path = "/dev/shm", uri = "file:{{ work }}/shm" },
]

libos.entrypoint = "/syscall_bench"
loader.log_level = "{{ log_level }}"
{% if rewrite == "1" %}sys.rewrite_syscalls = true{% elif rewrite == "0" %}sys.rewrite_syscalls = false{% endif %}
loader.insecure__use_cmdline_argv = true  # benchmark only: iterations come from argv

loader.env.LD_LIBRARY_PATH = "/lib:/lib/{{ arch_libdir }}"

fs.mounts = [
  { path = "/lib", uri = "file:{{ saguaro.runtimedir() }}" },
  { path = "/syscall_bench", uri = "file:syscall_bench" },
]

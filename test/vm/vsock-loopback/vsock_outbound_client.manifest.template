loader.entrypoint = "file:{{ saguaro.libos }}"
libos.entrypoint = "/vsock_outbound_client"
loader.log_level = "{{ env.get('SAGUARO_LOG_LEVEL', 'error') }}"
loader.env.LD_LIBRARY_PATH = "/lib:{{ arch_libdir }}:/usr/{{ arch_libdir }}"
loader.insecure__use_cmdline_argv = true

fs.mounts = [
  { path = "/lib", uri = "file:{{ saguaro.runtimedir(libc) }}" },
  { path = "/vsock_outbound_client", uri = "file:{{ binary_dir }}/vsock_outbound_client" },
  { path = "{{ arch_libdir }}", uri = "file:{{ arch_libdir }}" },
  { path = "/usr/{{ arch_libdir }}", uri = "file:/usr/{{ arch_libdir }}" },
]

vm.net.outbound = "{{ env.get('SAGUARO_VM_OUTBOUND', 'allow') }}"
vm.net.deny = [{% if env.get('SAGUARO_VM_DENY') %}"{{ env['SAGUARO_VM_DENY'] }}"{% endif %}]
vm.net.direct_vsock_ports = [6000]

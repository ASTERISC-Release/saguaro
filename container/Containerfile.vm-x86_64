# Development container for the x86_64 builds: the direct PAL and the vm-PAL unikernel (saguaro-vm)
# under QEMU/KVM. Counterpart of Containerfile.vm-aarch64.
#
# Requires an x86_64 host with working KVM (`/dev/kvm`) and `vhost-vsock` for the vm PAL; the direct
# PAL needs neither. Stock Ubuntu QEMU is used; TDX and the graphics redirection need the QEMU fork,
# which is not part of this image (build it separately and point QEMU_PATH at it).
#
# Build + start with container/run.sh.
FROM ubuntu:noble

ENV DEBIAN_FRONTEND=noninteractive

# Run layer: QEMU for the vm PAL (virtiofsd is shipped at /usr/lib/qemu/virtiofsd; saguaro-vm needs
# it on PATH, lsof for its pid-file check, python3-psutil for its VM-id allocation).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      qemu-system-x86 virtiofsd lsof python3-psutil kmod iproute2 iputils-ping gdb ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
ENV PATH="${PATH}:/usr/lib/qemu"

# Build layer: toolchain for LibOS + PALs (nasm is needed by the x86 tests).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential gcc make cmake patch git pkg-config gawk bison nasm \
      meson ninja-build python3 python3-click python3-jinja2 python3-pyelftools \
      python3-tomli python3-tomli-w python3-voluptuous \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# SGX layer: the protobuf-c tools of the SGX PAL (scripts/install.sh --sgx), which scripts/dependencies.sh does
# not install.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      protobuf-c-compiler libprotobuf-c-dev protobuf-compiler python3-protobuf \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Test layer: regression suites and example applications.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3-pytest python3-cryptography python3-toml procps file sqlite3 wget \
      curl tar autoconf automake libevent-dev zlib1g-dev netcat-openbsd cargo-1.85 rustc-1.85 \
      python3-numpy python3-scipy \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# The rust example's dependencies need a cargo newer than noble's default 1.75 (edition2024).
ENV PATH="/usr/lib/rust-1.85/bin:${PATH}"

# Graphics layer (see dev docs: graphics/): stock Mesa and the X/GL/SDL2 headers for the
# graphics preload library (libos/src/graphics) and CI-Examples/graphics, socat for the
# vsock-to-X proxy, and the packages needed to build the QEMU fork (qemu-saguaro, kept outside this repository)
# with its graphics listener.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      libgl1-mesa-dri libglx-mesa0 libegl-mesa0 libgbm1 mesa-utils x11-utils socat \
      libgl-dev libegl-dev libgbm-dev libdrm-dev libx11-dev libx11-xcb-dev libxshmfence-dev \
      libxcb1-dev libxcb-dri3-dev libxcb-present-dev libxcb-sync-dev libxcb-xfixes0-dev \
      libxcb-shape0-dev libxcb-randr0-dev libxcb-shm0-dev libxcb-render0-dev \
      libglib2.0-dev libpixman-1-dev libfdt-dev libcap-ng-dev libseccomp-dev libslirp-dev \
      python3-venv flex libsdl2-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Build dependencies of the larger graphics examples (CI-Examples/graphics: supertuxkart, quake2,
# minetest).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      subversion libbluetooth-dev libcurl4-openssl-dev libenet-dev libfreetype-dev \
      libharfbuzz-dev libjpeg-dev libogg-dev libopenal-dev libpng-dev libssl-dev libvorbis-dev \
      libmbedtls-dev libsqlite3-dev \
      unzip libxi-dev libxxf86vm-dev libgmp-dev libjsoncpp-dev libzstd-dev libluajit-5.1-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Vulkan (dev docs: vulkan/): Mesa's Vulkan drivers (anv, radv, lavapipe), the loader
# headers, vulkaninfo/vkcube, vkmark, the validation layers, the GLSL compiler for test/vulkan's
# shaders, and strace for the ioctl traces.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      mesa-vulkan-drivers libvulkan-dev vulkan-tools vkmark vulkan-validationlayers glslang-tools \
      strace \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Editors: the Ubuntu base image ships none, and the repository is edited inside the container.
# `vim` and not `vim-tiny`, because vim-tiny provides only `vi`. Kept as the last package layer so a
# rebuild after editing this line reuses every cached layer above it.
RUN apt-get update && \
    apt-get install -y --no-install-recommends vim nano \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN touch /var/lib/saguaro-vm-x86_64
WORKDIR /root

CMD ["bash"]

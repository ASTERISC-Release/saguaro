# Development container for the aarch64 vm-PAL unikernel (dev docs: vm.md / dev docs: CHANGELOG.md). Parallel to the x86 `Containerfile`
# (which targets the GPU/KVM/TDX Steam workflow); nothing here is shared.
#
# Target runtime is **KVM on a native aarch64 host** (`-accel kvm -cpu host`). Without
# /dev/kvm the launcher falls back to QEMU's software emulation (TCG, `-cpu max`): the same
# tests pass, only slower. The container exists to give a headless aarch64 box the
# QEMU/virtiofsd stack that the distro host does not ship.
#
# Build + start with container/run.sh (it passes `--device /dev/kvm` when the device exists).
#
# Ubuntu 24.04 (noble), matching the x86 Containerfile's pinned base image:
# the vm-PAL/LibOS build and the glibc/mbedtls subprojects are validated on
# noble's toolchain (gcc 13.3). Newer Ubuntu (26.04) ships gcc 15, which turns
# long-tolerated patterns into hard errors (C23 keyword-ifies memcpy/memmove in
# common/include/api.h; -Werror'd OPEN_TREE_CLONE clash building glibc 2.39
# against new kernel UAPI headers) -- deliberately not chased here.
#
# QEMU: stock noble qemu-system-arm (8.2.x) -- this is the documented requirement for the aarch64
# vm PAL (the numbers in dev docs: CHANGELOG.md use it). It is older than the
# 10.2.1 the initial bring-up ran on; virt/gic-version=3/KVM/vhost-user-fs behave the same for the
# vm kernel's needs, but if a future machine-shape dependency shows up, pin a
# newer QEMU in this layer (the kernel reads CPU count and PSCI conduit from
# the DTB, which both versions shape identically).
FROM ubuntu:noble

ENV DEBIAN_FRONTEND=noninteractive

# Run layer: everything tools/run-vm-aarch64-dev.sh invokes.
#   qemu-system-arm    -> /usr/bin/qemu-system-aarch64
#   virtiofsd          -> /usr/lib/qemu/virtiofsd (off PATH; the runner probes)
#   device-tree-compiler -> dtc, for the dumpdtb re-pack step
#   gdb                -> guest debugging (native aarch64 ELF, no gdb-multiarch)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      qemu-system-arm virtiofsd device-tree-compiler \
      kmod iproute2 iputils-ping gdb ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Build layer: meson/ninja/gcc toolchain for the vm PAL + LibOS
# (`meson setup build-vm-container -Dvm=enabled ...` + ninja; see dev docs: vm.md).
# The python3-* modules are Gramine's meson-time deps; patch/pkg-config feed the
# vendored subprojects (mbedtls's meson.build probes pkg-config). gawk+bison are
# glibc 2.39's configure requirements (fatal without them).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential gcc make cmake patch git pkg-config \
      gawk bison \
      meson ninja-build python3 python3-click python3-jinja2 \
      python3-tomli python3-tomli-w python3-voluptuous python3-pyelftools \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Test layer: the libos regression suite (`gramine-test` + pytest) run under `gramine-vm`
# (-Dtests=enabled -Dtests_pie=true; see dev docs: vm.md). procps/file/iproute2 are
# used by individual tests.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3-pytest python3-cryptography python3-toml python3-psutil procps file sqlite3 wget \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Example layer: what the CI-Examples need on the host (CI-Examples/*/exec.sh): curl and nc for the
# server checks, the development files that lighttpd (zlib), memcached (libevent) and nginx
# (OpenSSL, PCRE) build against, python3 venv/numpy/scipy for the python and pytorch examples, and
# the same cargo as the x86_64 image for the rust example.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      curl tar autoconf automake netcat-openbsd libevent-dev zlib1g-dev libssl-dev libpcre2-dev \
      cargo-1.85 rustc-1.85 python3-numpy python3-scipy python3-venv \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# The rust example's dependencies need a cargo newer than noble's default 1.75 (edition2024).
ENV PATH="/usr/lib/rust-1.85/bin:${PATH}"

# Editors: the Ubuntu base image ships none, and the repository is edited inside the container.
# `vim` and not `vim-tiny`, because vim-tiny provides only `vi`. Kept as the last package layer so a
# rebuild after editing this line reuses every cached layer above it.
RUN apt-get update && \
    apt-get install -y --no-install-recommends vim nano \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Marker + WORKDIR parity with the x86 image (repo mounts at /root/gramine-multiarch).
RUN touch /var/lib/gramine-vm-aarch64
WORKDIR /root

CMD ["bash"]

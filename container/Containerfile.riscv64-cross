# Development container for the RISC-V (riscv64) port: an x86_64 image with the riscv64 cross
# toolchain and qemu-system-riscv64. Gramine is cross-compiled here and tested in a RISC-V Linux
# guest under full-system emulation (see dev docs: riscv/PLAN.md). No KVM is involved:
# an x86_64 host cannot accelerate a RISC-V guest.
#
# Build + start with `container/run.sh --target riscv64`.
FROM ubuntu:noble

ENV DEBIAN_FRONTEND=noninteractive

# Cross toolchain and the host build tools of Gramine's build system.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential gcc make cmake patch git pkg-config gawk bison ca-certificates \
      meson ninja-build python3 python3-click python3-jinja2 python3-pyelftools \
      python3-tomli python3-tomli-w python3-voluptuous \
      gcc-riscv64-linux-gnu g++-riscv64-linux-gnu libc6-dev-riscv64-cross binutils-riscv64-linux-gnu \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Emulation: the system emulator with its firmware (OpenSBI, U-Boot) for the test guest, the
# user-mode emulator for running single riscv64 build helpers, and the tools to prepare and reach
# the guest (cloud-init seed image, ssh).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      qemu-system-misc qemu-utils opensbi u-boot-qemu qemu-user-static \
      cloud-image-utils openssh-client wget curl file gdb-multiarch iproute2 procps \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Editors: the Ubuntu base image ships none, and the repository is edited inside the container.
# `vim` and not `vim-tiny`, because vim-tiny provides only `vi`. Kept as the last package layer so a
# rebuild after editing this line reuses every cached layer above it.
RUN apt-get update && \
    apt-get install -y --no-install-recommends vim nano \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN touch /var/lib/gramine-riscv64-cross
WORKDIR /root

CMD ["bash"]

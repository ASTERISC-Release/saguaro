loader.entrypoint = "file:{{ saguaro.libos }}"
libos.entrypoint = "{{ entrypoint }}"

loader.env.LD_LIBRARY_PATH = "/lib"
loader.insecure__use_cmdline_argv = true

# Linux PAL only: connect() to this path reaches the host socket
sys.insecure__host_unix_sockets = ["/tmp/saguaro_host_unix_test.sock"]

fs.mounts = [
  { path = "/lib", uri = "file:{{ saguaro.runtimedir(libc) }}" },
  { path = "/{{ entrypoint }}", uri = "file:{{ binary_dir }}/{{ entrypoint }}" },
  { path = "/tmp", type = "chroot", uri = "file:/tmp" },
]

sgx.debug = true
sgx.edmm_enable = {{ 'true' if env.get('EDMM', '0') == '1' else 'false' }}

sgx.trusted_files = [
  "file:{{ saguaro.libos }}",
  "file:{{ saguaro.runtimedir(libc) }}/",
  "file:{{ binary_dir }}/{{ entrypoint }}",
]

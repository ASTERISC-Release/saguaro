{
    "file_format_version": "1.1.2",
    "layer": {
        "name": "VK_LAYER_SAGUARO_present",
        "type": "GLOBAL",
        "library_path": "/libgraphics.so",
        "api_version": "1.3.275",
        "implementation_version": "1",
        "description": "Vulkan presentation under saguaro-vm through the host listener (dev docs: vulkan/)",
        "functions": {

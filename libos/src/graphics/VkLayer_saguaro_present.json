        "instance_extensions": [
            { "name": "VK_KHR_surface", "spec_version": "25" },
            { "name": "VK_KHR_xcb_surface", "spec_version": "6" },
            { "name": "VK_KHR_xlib_surface", "spec_version": "6" },
            { "name": "VK_KHR_get_surface_capabilities2", "spec_version": "1" }
        ],
        "device_extensions": [
            { "name": "VK_KHR_swapchain", "spec_version": "70", "entrypoints": [
                "vkCreateSwapchainKHR", "vkDestroySwapchainKHR", "vkGetSwapchainImagesKHR",
                "vkAcquireNextImageKHR", "vkQueuePresentKHR", "vkAcquireNextImage2KHR",
                "vkGetDeviceGroupSurfacePresentModesKHR" ] }
        ],
        "enable_environment": { "EGL_VULKAN_PRESENT": "1" },
        "disable_environment": { "EGL_VULKAN_PRESENT_DISABLE": "1" }
    }

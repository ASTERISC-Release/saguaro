#!/usr/bin/env bash
# SPDX-License-Identifier: LGPL-3.0-or-later
# Copyright (C) 2023 Intel Corporation

# This file is based on `gramine.in` and modified for VM/TDX environment and QEMU.

BIOS_PATH=@BIOS_PATH@
LIBPAL_PATH=@LIBPAL_PATH@
HOST_PAL_PATH=@HOST_PAL_PATH@
TDSHIM_PAL_PATH=@TDSHIM_PAL_PATH@

APPLICATION=
QEMU_GDB=
ENVS=()
PREFIX=()

if [ "$GDB" == "1" ]; then
    QEMU_GDB="-gdb tcp::9000 -S"
fi

while [ "$1" != "" ]; do
    if [ "$APPLICATION" == "" ]; then
        APPLICATION=$1
        shift
        continue
    fi
    
    break
done

if [ "$APPLICATION" == "" ]; then
    echo "Usage: $0 [<application>] <args>..."
    exit 2
fi

# Try to get the VM memory config from `.manifest.tdx` file, by parsing `tdx.enclave_size` value.
# If this fails, try alternatively with `.manifest.sgx` and `sgx.enclave_size`
#
# We enforce a 1GB lower limit for VM memory because (a) Gramine VM kernel reserves ~512MB for
# shared virtio-queues memory, page tables, PAL binary, etc. and (b) for simplicity we want to reuse
# already-existing SGX manifests, thus we don't want to bump `sgx.enclave_size` to 1GB explicitly.
export GRAMINE_MANIFEST=$APPLICATION.manifest
QEMU_MEM_SIZE=$(python3 -c "
import os
import re
import sys
from graminelibos import Manifest

manifests = {
    'tdx': os.environ['GRAMINE_MANIFEST'] + '.tdx',
    'sgx': os.environ['GRAMINE_MANIFEST'] + '.sgx',
}

size_str = ''
for type, file in manifests.items():
    try:
        with open(file, 'rb') as f:
            manifest_data = f.read()
        manifest = Manifest.loads(manifest_data.decode('utf-8'))
        size_str = manifest[type]['enclave_size']
        break
    except Exception:
        continue
else:
    sys.exit(1)

unit = 1
if size_str.endswith('G'):
    unit = 1024 * 1024 * 1024
elif size_str.endswith('M'):
    unit = 1024 * 1024
elif size_str.endswith('K'):
    unit = 1024

try:
    size = int(re.search(r'\d+', size_str).group())
    print(size_str if unit * size > 1024 * 1024 * 1024 else '1G')
except Exception:
    sys.exit(1)
")
# If file parsing fails, then try the config from environment variable `GRAMINE_RAM_SIZE`.
QEMU_MEM_SIZE=${QEMU_MEM_SIZE:-$GRAMINE_RAM_SIZE}
# If both file and envvar parsing fail, then fall back to the default value of 8GB.
QEMU_MEM_SIZE=${QEMU_MEM_SIZE:-"8G"}

# Try the config from environment variable `GRAMINE_CPU_NUM`, then fall back to default of 1.
QEMU_CPU_NUM=${QEMU_CPU_NUM:-$GRAMINE_CPU_NUM}
QEMU_CPU_NUM=${QEMU_CPU_NUM:-"1"}

# GRAMINE_CPU_NUM="7"
# QEMU_CPU_NUM=$GRAMINE_CPU_NUM

# QEMU: QEMU_PATH in the environment, else a stock qemu-system-x86_64 from PATH. TDX and the graphics
# redirection need a QEMU fork built outside this repository (see Documentation/devel/graphics/).
QEMU_PATH=${QEMU_PATH:-$(command -v qemu-system-x86_64 || echo qemu-system-x86_64)}

QEMU_VM="-cpu host,host-phys-bits,-kvm-steal-time,pmu=off,+tsc-deadline,+invtsc \
-m $QEMU_MEM_SIZE -smp $QEMU_CPU_NUM"
QEMU_OPTS="-enable-kvm -vga none -display none -no-reboot -monitor none "

RAW_MEM_SIZE=$(echo $QEMU_MEM_SIZE | tr -d 'G')
REM_MEM_SIZE=$((RAW_MEM_SIZE - 4))
if [ "$GRAMINE_HUGEPAGES" == "1" ]; then
    echo "Configuring Gramine VM with hugepages support."
    if [ "$(echo $QEMU_MEM_SIZE | tr -d 'G')" -lt 8 ]; then
        echo "Error: Gramine hugepages mode requires at least 8GB of VM memory."
        exit 2
    fi

    REM_MEM_SIZE="$((REM_MEM_SIZE))G"
    echo "REM_MEM_SIZE = $REM_MEM_SIZE"

    # 3 separate DIMMs (0 - 4GB hugepages, 4GB - 5GB normal, 5GB - rest hugepages)
    QEMU_OPTS+="-object memory-backend-memfd,id=huge0,size=2G,hugetlb=on,hugetlbsize=2M \
    -object memory-backend-memfd,id=ram1,size=2G \
    -object memory-backend-memfd,id=huge2,size=$REM_MEM_SIZE,hugetlb=on,hugetlbsize=2M \
    -numa node,memdev=huge0,nodeid=0 \
    -numa node,memdev=ram1,nodeid=1 \
    -numa node,memdev=huge2,nodeid=2 "
else
    echo "Configuring Gramine VM without hugepages."

    # 3 separate DIMMs (0 - 4GB hugepages, 4GB - 5GB normal, 5GB - rest hugepages)
    REM_MEM_SIZE="$((REM_MEM_SIZE))G"
    echo "REM_MEM_SIZE = $REM_MEM_SIZE"
    QEMU_OPTS+="-object memory-backend-memfd,id=huge0,size=2G \
    -object memory-backend-memfd,id=ram1,size=2G \
    -object memory-backend-memfd,id=huge2,size=$REM_MEM_SIZE \
    -numa node,memdev=huge0,nodeid=0 \
    -numa node,memdev=ram1,nodeid=1 \
    -numa node,memdev=huge2,nodeid=2 "
fi

if [ "$TDSHIM_PAL_PATH" == "" ]; then
    QEMU_MACHINE="-M q35,kernel_irqchip=on"
    QEMU_BINARIES="-kernel $LIBPAL_PATH -device loader,file=$BIOS_PATH"
else
    QEMU_MACHINE="-M q35,kernel_irqchip=split,confidential-guest-support=tdx \
    -object tdx-guest,id=tdx,quote-generation-service=vsock:2:4050"
    QEMU_BINARIES="-bios $TDSHIM_PAL_PATH"
fi

# We need to specify a Gramine VM ID to be able to run two independent Gramine instances at the
# same time on the same machine. They are used as IDs for the virtiofs and the vsock guest-cid.
DEFAULT_GRAMINE_VM_ID=10
GRAMINE_VM_ID=$(python3 -c "
import psutil
import re

# Identify the qemu processes
qemu_processes = []
try:
    for process in psutil.process_iter(['pid', 'name', 'cmdline']):
        if 'qemu' in process.info['name']:
            qemu_processes.append(process)
except Exception:
    sys.exit('Exception while iterating over system processes.')

# Identify the occupied guest-cids
used_cids = set()
for process in qemu_processes:
    pid = process.info['pid']
    cmdline = ' '.join(process.info['cmdline'])
    match = re.search(r'guest-cid=(\d+)', cmdline)
    guest_cid = int(match.group(1)) if match else None
    if guest_cid is not None:
        used_cids.add(guest_cid)

# Identify the next available Gramine VM ID based on the uniquely assigned vsock guest-cid.
cid = "$DEFAULT_GRAMINE_VM_ID"
while cid in used_cids:
    cid += 1

# Check that the guest-cid is in a valid range
if cid > 2 and cid < 0xffffffff:
    print(cid)
else:
    sys.exit('Invalid chosen CID value: ' + str(cid) + '. It must be > 2 and < 0xffffffff.')
" 2>&1)
EXIT_STATUS=$?

if [ $EXIT_STATUS -ne 0 ]; then
    echo "Error: Python script for determining the Gramine-VM ID exited with a non-zero status: $EXIT_STATUS"
    echo "Error message: $GRAMINE_VM_ID"
    exit $EXIT_STATUS
fi

# The console is stdio, with a log copy so the guest's exit code can be recovered afterwards: the
# guest ends with a triple fault, so QEMU's own exit status says nothing about the application.
CONSOLE_LOG=$(mktemp /tmp/gramine-vm-console.XXXXXX)
XPROXY_LOG=
cleanup() {
    rm -f "$CONSOLE_LOG" ${XPROXY_LOG:+"$XPROXY_LOG"}
    [ -n "${VIRTIOFSD_PID:-}" ] && kill "$VIRTIOFSD_PID" 2>/dev/null
    # the X proxy forks one child per connection; stop those along with the listener
    if [ -n "${XPROXY_PID:-}" ]; then
        pkill -P "$XPROXY_PID" 2>/dev/null
        kill "$XPROXY_PID" 2>/dev/null
        wait "$XPROXY_PID" 2>/dev/null
    fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM
QEMU_VIRTIO_CONSOLE="-device virtio-serial,iommu_platform=off,romfile= \
-chardev stdio,id=virtioconsole0,logfile=$CONSOLE_LOG \
-device virtconsole,chardev=virtioconsole0"
QEMU_VIRTIO_FS="-chardev socket,path=/tmp/gramine_vhostfs_"$GRAMINE_VM_ID",id=vhostfs \
-device vhost-user-fs-pci,iommu_platform=off,queue-size=1024,chardev=vhostfs,tag=graminefs"
QEMU_VIRTIO_VSOCK="-device vhost-vsock-pci,iommu_platform=off,guest-cid="$GRAMINE_VM_ID",id=vsockdev"

# The guest splits this string on whitespace but keeps "double-quoted" tokens whole (no escapes), so
# quote every argument: `gramine-vm app -c "echo hi"` must reach the app as two arguments.
GRAMINE_ARGS="-gramine-args init \"$APPLICATION\""
for arg in "$@"; do
    GRAMINE_ARGS+=" \"$arg\""
done
GRAMINE_ARGS+=" -gramine-args-end"
# Due to QEMU syntax, commas in the QEMU cmdline need to be escaped using an additional comma.
GRAMINE_ARGS=${GRAMINE_ARGS//","/",,"}

GRAMINE_ENVS=$(python3 -c "
import os
env_str = ''
for name, value in os.environ.items():
    env_str += ('\"{0}={1}\" '.format(name, value).replace(',', ',,'))
print(env_str)
")
GRAMINE_ENVS="-gramine-envs $GRAMINE_ENVS -gramine-envs-end"

CMD=("${ENVS[@]}")
CMD+=("${PREFIX[@]}")
CMD+=($QEMU_PATH $QEMU_GDB $QEMU_VM $QEMU_OPTS $QEMU_MACHINE
    $QEMU_VIRTIO_CONSOLE $QEMU_VIRTIO_FS $QEMU_VIRTIO_VSOCK $QEMU_BINARIES
    -fw_cfg name=opt/gramine/pwd,string="$PWD"
    -fw_cfg name=opt/gramine/args,string="$GRAMINE_ARGS"
    -fw_cfg name=opt/gramine/envs,string="$GRAMINE_ENVS"
-fw_cfg name=opt/gramine/unixtime_s,string="$EPOCHSECONDS")

# X proxy for graphics applications. A manifest that sets `loader.env.DISPLAY = "2:N"` points the
# application at the X server of the host (vsock CID 2), which the guest reaches on vsock port
# 6000+N. Relay that port to the X socket named by this launcher's own DISPLAY for as long as the VM
# runs. GRAMINE_VM_X_PROXY=0 disables this (e.g. when the relay runs elsewhere), and
# GRAMINE_VM_X_DISPLAY names another local display. A listener that is already there is reused and
# left running.
X_DISPLAY_NUM=$(python3 -c "
import os, re, sys
try:
    import tomli as tomllib
except ImportError:
    import tomllib
try:
    with open(os.environ['GRAMINE_MANIFEST'], 'rb') as f:
        display = tomllib.load(f).get('loader', {}).get('env', {}).get('DISPLAY', '')
except Exception:
    sys.exit(0)
if isinstance(display, dict):
    display = display.get('value', '')
m = re.fullmatch(r'2:(\\d+)(\\.\\d+)?', str(display))
if m:
    print(m.group(1))
" 2>/dev/null)
if [ -n "$X_DISPLAY_NUM" ] && [ "${GRAMINE_VM_X_PROXY:-1}" != "0" ]; then
    XPROXY_PORT=$((6000 + X_DISPLAY_NUM))
    HOST_DISPLAY=${GRAMINE_VM_X_DISPLAY:-$DISPLAY}
    if [[ ! "$HOST_DISPLAY" =~ ^(unix)?:([0-9]+)(\.[0-9]+)?$ ]]; then
        echo "Error: the manifest uses the host display (DISPLAY=2:$X_DISPLAY_NUM) but this" \
             "environment has no local X display (DISPLAY='$HOST_DISPLAY')." >&2
        echo "Set DISPLAY or GRAMINE_VM_X_DISPLAY to a local display such as :0, or set" \
             "GRAMINE_VM_X_PROXY=0 and provide the vsock relay yourself." >&2
        exit 2
    fi
    HOST_X_SOCKET=/tmp/.X11-unix/X${BASH_REMATCH[2]}
    if command -v ss >/dev/null 2>&1 \
            && ss -H -ln --vsock "sport = :$XPROXY_PORT" 2>/dev/null | grep -q .; then
        echo "gramine-vm: using the X proxy already listening on vsock port $XPROXY_PORT" >&2
    else
        if ! command -v socat >/dev/null 2>&1; then
            echo "Error: socat is needed to relay the application's X connection" \
                 "(vsock port $XPROXY_PORT -> $HOST_X_SOCKET)." >&2
            exit 2
        fi
        if [ ! -S "$HOST_X_SOCKET" ]; then
            echo "Error: the X socket $HOST_X_SOCKET does not exist (DISPLAY='$HOST_DISPLAY')." >&2
            exit 2
        fi
        XPROXY_LOG=$(mktemp /tmp/gramine-vm-xproxy.XXXXXX)
        socat -b 1048576 "VSOCK-LISTEN:$XPROXY_PORT,fork,reuseaddr,max-children=50" \
            "UNIX-CONNECT:$HOST_X_SOCKET" >"$XPROXY_LOG" 2>&1 &
        XPROXY_PID=$!
        # wait until it listens (or has failed) before booting the guest
        for _ in $(seq 30); do
            kill -0 "$XPROXY_PID" 2>/dev/null || break
            if command -v ss >/dev/null 2>&1; then
                ss -H -ln --vsock "sport = :$XPROXY_PORT" 2>/dev/null | grep -q . && break
            fi
            sleep 0.1
        done
        if ! kill -0 "$XPROXY_PID" 2>/dev/null; then
            echo "Error: could not start the X proxy on vsock port $XPROXY_PORT:" >&2
            grep -v '/dev/vsock' "$XPROXY_LOG" >&2
            XPROXY_PID=
            exit 2
        fi
    fi
fi

# Check if the Gramine vhostfs pid file is already in use by another process
if lsof /tmp/gramine_vhostfs_"$GRAMINE_VM_ID".pid 2>/dev/null; then
    echo "Error: /tmp/gramine_vhostfs_"$GRAMINE_VM_ID".pid is already in use."
    exit 2
fi
virtiofsd --socket-path /tmp/gramine_vhostfs_"$GRAMINE_VM_ID" --shared-dir / --log-level error \
--sandbox none --no-announce-submounts &
VIRTIOFSD_PID=$!
while [ ! -e /tmp/gramine_vhostfs_"$GRAMINE_VM_ID" ]; do sleep 0.1; done

# (not `exec`: the exit code has to be recovered from the console log after QEMU is gone)
env "${CMD[@]}"
QEMU_RC=$?

[ -n "$GRAMINE_VM_CONSOLE_LOG" ] && cp "$CONSOLE_LOG" "$GRAMINE_VM_CONSOLE_LOG" 2>/dev/null

# `_PalProcessExit` logs "[ VM exited with code N ]" just before the guest triple-faults (QEMU then
# exits 0 because of -no-reboot, whatever the application did).
GUEST_RC=$(sed -n 's/.*VM exited with code \([0-9]*\).*/\1/p' "$CONSOLE_LOG" 2>/dev/null | tail -1)
if [ -n "$GUEST_RC" ]; then
    exit "$GUEST_RC"
elif grep -q "Panic" "$CONSOLE_LOG" 2>/dev/null; then
    exit 134            # kernel panic before the guest could report an exit code
fi
exit "$QEMU_RC"

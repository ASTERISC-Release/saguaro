#!/usr/bin/env bash
# SPDX-License-Identifier: LGPL-3.0-or-later
# Copyright (C) 2023 Intel Corporation

# This file is based on `saguaro.in` (upstream `gramine.in`) and modified for VM/TDX environment and QEMU.

BIOS_PATH=@BIOS_PATH@
LIBPAL_PATH=@LIBPAL_PATH@
HOST_PAL_PATH=@HOST_PAL_PATH@
TDSHIM_PAL_PATH=@TDSHIM_PAL_PATH@
# saguaro-sev (the AMD SEV build of this launcher): the IGVM boot image, empty for saguaro-vm
SEV_IGVM_PATH=@SEV_IGVM_PATH@
SEV_QEMU_PATH=@SEV_QEMU_PATH@

# The per-VM vsock relay (dev docs: CHANGELOG.md), shared with saguaro-vm-aarch64; installed
# next to the VM PAL. The launcher runs Python snippets and the relay from this installation: a caller
# with a stripped environment (the LibOS regression tests pass `env=`) has no PYTHONPATH, so the library
# finds the package next to the launcher.
. "$HOST_PAL_PATH/vm-relay.sh"
vm_relay_find_python "${BASH_SOURCE[0]}"

APPLICATION=
QEMU_GDB=
ENVS=()
PREFIX=()

if [ "$GDB" == "1" ]; then
    QEMU_GDB="-gdb tcp::9000 -S"
fi

while [ "$1" != "" ]; do
    if [ "$APPLICATION" == "" ]; then
        APPLICATION=$1
        shift
        continue
    fi
    
    break
done

if [ "$APPLICATION" == "" ]; then
    echo "Usage: $0 [<application>] <args>..."
    exit 2
fi

# Try to get the VM memory config from `.manifest.tdx` file, by parsing `tdx.enclave_size` value.
# If this fails, try alternatively with `.manifest.sgx` and `sgx.enclave_size`
#
# We enforce a 1GB lower limit for VM memory because (a) Gramine VM kernel reserves ~512MB for
# shared virtio-queues memory, page tables, PAL binary, etc. and (b) for simplicity we want to reuse
# already-existing SGX manifests, thus we don't want to bump `sgx.enclave_size` to 1GB explicitly.
export SAGUARO_MANIFEST=$APPLICATION.manifest
QEMU_MEM_SIZE=$(python3 -c "
import os
import re
import sys
from graminelibos import Manifest

manifests = {
    'tdx': os.environ['SAGUARO_MANIFEST'] + '.tdx',
    'sgx': os.environ['SAGUARO_MANIFEST'] + '.sgx',
}

size_str = ''
for type, file in manifests.items():
    try:
        with open(file, 'rb') as f:
            manifest_data = f.read()
        manifest = Manifest.loads(manifest_data.decode('utf-8'))
        size_str = manifest[type]['enclave_size']
        break
    except Exception:
        continue
else:
    sys.exit(1)

unit = 1
if size_str.endswith('G'):
    unit = 1024 * 1024 * 1024
elif size_str.endswith('M'):
    unit = 1024 * 1024
elif size_str.endswith('K'):
    unit = 1024

try:
    size = int(re.search(r'\d+', size_str).group())
    print(size_str if unit * size > 1024 * 1024 * 1024 else '1G')
except Exception:
    sys.exit(1)
")
# If file parsing fails, then try the config from environment variable `SAGUARO_RAM_SIZE`.
QEMU_MEM_SIZE=${QEMU_MEM_SIZE:-$SAGUARO_RAM_SIZE}
# If both file and envvar parsing fail, then fall back to the default value of 8GB.
QEMU_MEM_SIZE=${QEMU_MEM_SIZE:-"8G"}

# Try the config from environment variable `SAGUARO_CPU_NUM`, then fall back to default of 1.
QEMU_CPU_NUM=${QEMU_CPU_NUM:-$SAGUARO_CPU_NUM}
QEMU_CPU_NUM=${QEMU_CPU_NUM:-"1"}

# SAGUARO_CPU_NUM="7"
# QEMU_CPU_NUM=$SAGUARO_CPU_NUM

# QEMU: QEMU_PATH in the environment, else a stock qemu-system-x86_64 from PATH. TDX and the graphics
# redirection need a QEMU fork built outside this repository (see dev docs: graphics/).
# saguaro-sev: the QEMU configured with -Dsev_qemu, if any (the LibOS tests run it with a stripped
# environment)
[ -n "$SEV_QEMU_PATH" ] && QEMU_PATH=${QEMU_PATH:-$SEV_QEMU_PATH}
QEMU_PATH=${QEMU_PATH:-$(command -v qemu-system-x86_64 || echo qemu-system-x86_64)}

QEMU_VM="-cpu host,host-phys-bits,-kvm-steal-time,pmu=off,+tsc-deadline,+invtsc \
-m $QEMU_MEM_SIZE -smp $QEMU_CPU_NUM"
QEMU_OPTS="-enable-kvm -vga none -display none -no-reboot -monitor none "
# SAGUARO_VM_MONITOR=<path>: the QEMU monitor on a unix socket, so that a hung guest can be looked
# at from outside (test/vm/multiproc/vm-hang-report.py)
[ -n "$SAGUARO_VM_MONITOR" ] && \
    QEMU_OPTS="${QEMU_OPTS/-monitor none/-monitor unix:$SAGUARO_VM_MONITOR,server=on,wait=off}"
# SAGUARO_VM_QMP=<path>: a QMP socket (e.g. for query-sev-launch-measure under saguaro-sev)
[ -n "$SAGUARO_VM_QMP" ] && QEMU_OPTS+="-qmp unix:$SAGUARO_VM_QMP,server=on,wait=off "

RAW_MEM_SIZE=$(echo $QEMU_MEM_SIZE | tr -d 'G')
REM_MEM_SIZE=$((RAW_MEM_SIZE - 4))

# Graphics applications (see dev docs: graphics/): a manifest with loader.env.DISPLAY
# set to the host ("2:N") marks one. The GEM arenas -- the data arena (size from
# SAGUARO_DATA_SIZE, default 1G) plus the fixed 1G hugepage arena -- start at guest physical 4G
# and must fit inside guest RAM: data + 1G <= 2G (ram1) + REM, i.e. RAM >= 3G + data, and at
# least 5G so that a non-empty huge2 backs the application itself. (The rendered manifest lists
# the environment keys inside the [loader.env] table, hence the bare DISPLAY match.)
# SAGUARO_VM_GRAPHICS=0 keeps the X relay (below) but configures no arenas: for an X11 application
# that renders in software and needs the demand-paged address space instead of the identity-mapped
# first process the arenas imply (Wine, dev docs: proton-vm/).
if [ "${SAGUARO_VM_GRAPHICS:-1}" != 0 ] && grep -Eq '^DISPLAY[^=]*=[[:space:]]*"2:' "$SAGUARO_MANIFEST" 2>/dev/null; then
    GRAPHICS_DATA_SIZE=${SAGUARO_DATA_SIZE:-1G}
    # Where the data arena starts. 4G is the anchor today; an explicit override relocates it
    # (the arena and the hugepage arena after it must still be backed by guest RAM, which lives
    # at [0-2G) and [4G; ...) -- below-4G placements are rejected here, and C2 makes the whole
    # backend map (and this constraint) dynamic.
    GRAPHICS_DATA_ADDR=${SAGUARO_DATA_ADDR:-4294967296}
    case "$GRAPHICS_DATA_ADDR" in
        *[!0-9]*)   echo "Error: SAGUARO_DATA_ADDR must be a byte address in decimal (got '$GRAPHICS_DATA_ADDR')."; exit 2 ;;
    esac
    if [ "$GRAPHICS_DATA_ADDR" -lt 4294967296 ]; then
        echo "Error: SAGUARO_DATA_ADDR must be at least guest physical 4G (got $GRAPHICS_DATA_ADDR); guest RAM between 2G and 4G is the PCI hole."
        exit 2
    fi
    case "$GRAPHICS_DATA_SIZE" in
        *G) GRAPHICS_DATA_BYTES=$(( ${GRAPHICS_DATA_SIZE%G} * 1073741824 )) ;;
        *M) GRAPHICS_DATA_BYTES=$(( ${GRAPHICS_DATA_SIZE%M} * 1048576 )) ;;
        *)  GRAPHICS_DATA_BYTES=$(( ${GRAPHICS_DATA_SIZE:-0} + 0 )) ;;
    esac
    # The RAM floor: the arena window [GRAPHICS_DATA_ADDR, + data + hugepage-arena) must end
    # inside guest RAM, which reaches RAM+2G; the fixed 3G of backends make that 4G at the
    # default anchor (hugepages deployments need 5G: the bucket is the third fixed backend).
    NEED_RAM=$(( (GRAPHICS_DATA_ADDR + GRAPHICS_DATA_BYTES + 1073741824 - 2147483648 + 1073741823) / 1073741824 ))
    MIN_FLOOR=4
    [ "${SAGUARO_HUGEPAGES:-0}" = "1" ] && MIN_FLOOR=5
    if [ "$NEED_RAM" -lt "$MIN_FLOOR" ]; then NEED_RAM=$MIN_FLOOR; fi
    if [ "$RAW_MEM_SIZE" -lt "$NEED_RAM" ]; then
        echo "Error: this graphics application needs at least ${NEED_RAM}G of guest RAM for data" \
             "arena $GRAPHICS_DATA_SIZE at address $GRAPHICS_DATA_ADDR (got ${QEMU_MEM_SIZE})."
        exit 2
    fi
    # Where the hugepage GEM arena lives: in a hugepages deployment, at the dedicated 1G hugetlb
    # bucket backend at guest 6G (data arenas elsewhere are not supported yet -- C2 makes the
    # backend map dynamic); in a normal deployment it follows the data arena. The PAL gets all
    # three numbers over fw_cfg and the guest library over its environment, so they are exported
    # for exactly one knob in.
    if [ "${SAGUARO_HUGEPAGES:-0}" = "1" ]; then
        if [ "$GRAPHICS_DATA_ADDR" != 4294967296 ]; then
            echo "Error: hugepages deployments keep the data arena at guest physical 4G" \
                 "(the dedicated 1G hugetlb bucket sits at 6G); SAGUARO_DATA_ADDR=$GRAPHICS_DATA_ADDR is not supported. Unset SAGUARO_HUGEPAGES to relocate, or wait for C2."
            exit 2
        fi
        if [ "$GRAPHICS_DATA_BYTES" -gt 2147483648 ]; then
            echo "Error: SAGUARO_HUGEPAGES=1 serves the hugepage GEM bucket from a dedicated 1G" \
                 "hugetlb backend at guest 6G, so SAGUARO_DATA_SIZE must be at most 2G (got" \
                 "$GRAPHICS_DATA_SIZE). Reduce it or unset SAGUARO_HUGEPAGES."
            exit 2
        fi
        GRAPHICS_HUGE_ADDR=6442450944          # guest physical 6G
    else
        GRAPHICS_HUGE_ADDR=$((GRAPHICS_DATA_ADDR + GRAPHICS_DATA_BYTES))   # follows the data arena
    fi
    echo "Graphics data arena: $GRAPHICS_DATA_SIZE at 0x$(printf %x $GRAPHICS_DATA_ADDR) ($GRAPHICS_DATA_BYTES bytes; guest RAM floor ${NEED_RAM}G; hugepage arena at 0x$(printf %x $GRAPHICS_HUGE_ADDR))"
    SAGUARO_HUGEPAGE_ADDR=$GRAPHICS_HUGE_ADDR
    SAGUARO_DATA_SIZE=$GRAPHICS_DATA_SIZE
fi
[ -n "${GRAPHICS_HUGE_ADDR:-}" ] && export SAGUARO_HUGEPAGE_ADDR
[ -n "${GRAPHICS_DATA_SIZE:-}" ] && export SAGUARO_DATA_SIZE
[ -n "${GRAPHICS_DATA_ADDR:-}" ] && export SAGUARO_DATA_ADDR
GRAPHICS_BACKEND_ARGS=""

if [ "$SAGUARO_HUGEPAGES" == "1" ]; then
    # echo "Configuring Gramine VM with hugepages support."
    if [ "$RAW_MEM_SIZE" -lt 5 ]; then
        echo "Error: hugepages deployments need at least 5G of guest RAM (2G hugetlb below" \
             "4G for kernel+app, 2G normal pages at 4-6G for the data arena, and the 1G" \
             "hugetlb GEM bucket at 6-7G)."
        exit 2
    fi

    # Backends in QEMU's -numa placement rule: node 0 at guest physical 0, every later node
    # sequentially from 4G. 2G hugetlb below 4G (kernel+app), 2G normal at 4-6G (the data
    # arena), the dedicated 1G hugetlb bucket at 6-7G (the hugepage GEM arena -- the only
    # hugetlb memory), and normal pages for the rest: only the 3G of fixed backends is
    # committed up front. SAGUARO_RAM_BASES carries the guest base of each memfd backend,
    # in -object order, to the QEMU fork's identity-mapped placement.
    RAM_BASES=0,4294967296,6442450944
    GRAPHICS_BACKEND_ARGS+="-object memory-backend-memfd,id=huge0,size=2G,hugetlb=on,hugetlbsize=2M \
    -object memory-backend-memfd,id=ram1,size=2G \
    -object memory-backend-memfd,id=huge_bucket,size=1G,hugetlb=on,hugetlbsize=2M "
    REM_MEM_SIZE=$((RAW_MEM_SIZE - 5))
    HAVE_APP_BACKEND=0
    [ "$REM_MEM_SIZE" -gt 0 ] && HAVE_APP_BACKEND=1
    if [ "$HAVE_APP_BACKEND" = 1 ]; then
        REM_MEM_SIZE="${REM_MEM_SIZE}G"
        # echo "REM_MEM_SIZE = $REM_MEM_SIZE (only touched when used)"
        GRAPHICS_BACKEND_ARGS+="-object memory-backend-memfd,id=ram2,size=$REM_MEM_SIZE "
        RAM_BASES+=",$((7 * 1073741824))"
    else
        echo "no fourth backend (RAM=5G)"
    fi
    GRAPHICS_BACKEND_ARGS+="-numa node,memdev=huge0,nodeid=0 \
    -numa node,memdev=ram1,nodeid=1 \
    -numa node,memdev=huge_bucket,nodeid=2 "
    [ "$HAVE_APP_BACKEND" = 1 ] && GRAPHICS_BACKEND_ARGS+="-numa node,memdev=ram2,nodeid=3 "
else
    # echo "Configuring Gramine VM without hugepages."

    # 2G below 4G for kernel+app, 2G normal at 4-6G (the GEM arenas; at RAM=4G they fill it
    # entirely), and normal pages for the rest. 4 guests get no third backend.
    RAM_BASES=0,4294967296
    GRAPHICS_BACKEND_ARGS="-object memory-backend-memfd,id=huge0,size=2G \
    -object memory-backend-memfd,id=ram1,size=2G "
    REM_MEM_SIZE=$((RAW_MEM_SIZE - 4))
    HAVE_APP_BACKEND=0
    [ "$REM_MEM_SIZE" -gt 0 ] && HAVE_APP_BACKEND=1
    if [ "$HAVE_APP_BACKEND" = 1 ]; then
        REM_MEM_SIZE="${REM_MEM_SIZE}G"
        # echo "REM_MEM_SIZE = $REM_MEM_SIZE (only touched when used)"
        GRAPHICS_BACKEND_ARGS+="-object memory-backend-memfd,id=huge2,size=$REM_MEM_SIZE "
        RAM_BASES+=",$((6 * 1073741824))"
    else
        echo "no third backend (RAM=4G; the GEM arenas live entirely in ram1)"
    fi
    GRAPHICS_BACKEND_ARGS+="-numa node,memdev=huge0,nodeid=0 \
    -numa node,memdev=ram1,nodeid=1 "
    [ "$HAVE_APP_BACKEND" = 1 ] && GRAPHICS_BACKEND_ARGS+="-numa node,memdev=huge2,nodeid=2 "
fi
QEMU_OPTS+="$GRAPHICS_BACKEND_ARGS"
# The bases go to the QEMU fork's placement logic (per-backend identity mapping) as env -- the
# guest never sees this one.
export SAGUARO_RAM_BASES=$RAM_BASES

if [ -n "$SEV_IGVM_PATH" ]; then
    # AMD SEV (dev docs: sev/): the IGVM file holds the PAL and its boot stub, QEMU
    # encrypts and measures every page of it at launch; no -kernel, no BIOS loader.
    # SAGUARO_SEV_MODE (or the manifest's `sev.mode`): snp (SEV-SNP, the default), sev (plain SEV)
    # or native (the same image without encryption, for debugging the boot path; the PAL then
    # refuses to run). SAGUARO_SEV_POLICY (or `sev.policy`): the guest policy (SNP 0x30000, SEV 0x1). SAGUARO_SEV_SESSION=<prefix>: the
    # launch session of `sevctl session` (<prefix>_godh.b64, <prefix>_session.b64), whose TIK
    # verifies the launch measurement.
    # The manifest may choose them too (`sev.mode`, `sev.policy`); the environment wins.
    SEV_MANIFEST=$(python3 -c "
import sys
try:
    import tomllib
except ImportError:
    import tomli as tomllib
try:
    with open(sys.argv[1], 'rb') as f:
        sev = tomllib.load(f).get('sev', {})
except Exception:
    sev = {}
print(sev.get('mode', ''), sev.get('policy', ''))
" "$SAGUARO_MANIFEST" 2>/dev/null)
    read -r SEV_MANIFEST_MODE SEV_MANIFEST_POLICY <<<"$SEV_MANIFEST"
    SEV_MODE=${SAGUARO_SEV_MODE:-${SEV_MANIFEST_MODE:-snp}}
    SAGUARO_SEV_POLICY=${SAGUARO_SEV_POLICY:-$SEV_MANIFEST_POLICY}
    SEV_CBITPOS=${SAGUARO_SEV_CBITPOS:-$(python3 "$HOST_PAL_PATH/saguaro-sev-igvm.py" cbitpos)}
    case "$SEV_MODE" in
        sev)
            SEV_OBJECT="sev-guest,id=sev0,cbitpos=$SEV_CBITPOS,reduced-phys-bits=1,policy=${SAGUARO_SEV_POLICY:-0x1}"
            [ -n "$SAGUARO_SEV_SESSION" ] && \
                SEV_OBJECT+=",dh-cert-file=${SAGUARO_SEV_SESSION}_godh.b64,session-file=${SAGUARO_SEV_SESSION}_session.b64"
            QEMU_MACHINE="-M q35,kernel_irqchip=on,confidential-guest-support=sev0,igvm-cfg=igvm0 \
            -object $SEV_OBJECT" ;;
        snp)
            # KVM offers no TSC-deadline timer to SEV-ES/SNP guests (the PAL uses the one-shot
            # LAPIC timer instead), so do not ask for it
            QEMU_VM=${QEMU_VM/,+tsc-deadline/}
            SEV_OBJECT="sev-snp-guest,id=sev0,cbitpos=$SEV_CBITPOS,reduced-phys-bits=1,policy=${SAGUARO_SEV_POLICY:-0x30000}"
            QEMU_MACHINE="-M q35,kernel_irqchip=on,confidential-guest-support=sev0,igvm-cfg=igvm0 \
            -object $SEV_OBJECT" ;;
        native)
            QEMU_MACHINE="-M q35,kernel_irqchip=on,igvm-cfg=igvm0" ;;
        *)
            echo "Error: SAGUARO_SEV_MODE must be sev, snp or native (got '$SEV_MODE')." >&2
            exit 2 ;;
    esac
    QEMU_MACHINE+=" -object igvm-cfg,id=igvm0,file=$SEV_IGVM_PATH"
    QEMU_BINARIES=""
    # the launch digest the platform must report for this file and vCPU count (SNP: the
    # MEASUREMENT of the attestation report; SEV: the digest inside LAUNCH_MEASURE)
    if [ "$SEV_MODE" != native ]; then
        SEV_DIGEST=$(python3 "$HOST_PAL_PATH/saguaro-sev-igvm.py" measure --mode "$SEV_MODE" \
                     --vcpus "$QEMU_CPU_NUM" "$SEV_IGVM_PATH")
        echo "saguaro-sev: $SEV_MODE launch digest of $SEV_IGVM_PATH on $QEMU_CPU_NUM vCPUs: $SEV_DIGEST" >&2
    fi
elif [ "$TDSHIM_PAL_PATH" == "" ]; then
    QEMU_MACHINE="-M q35,kernel_irqchip=on"
    QEMU_BINARIES="-kernel $LIBPAL_PATH -device loader,file=$BIOS_PATH"
else
    QEMU_MACHINE="-M q35,kernel_irqchip=split,confidential-guest-support=tdx \
    -object tdx-guest,id=tdx,quote-generation-service=vsock:2:4050"
    QEMU_BINARIES="-bios $TDSHIM_PAL_PATH"
fi

# We need to specify a Gramine VM ID to be able to run two independent Gramine instances at the
# same time on the same machine. They are used as IDs for the virtiofs and the vsock guest-cid.
# SAGUARO_VM_ID_BASE: set per workspace by container/run.sh, so that containers of different
# checkouts do not pick the same (host-global) guest CID.
DEFAULT_GRAMINE_VM_ID=${SAGUARO_VM_ID_BASE:-10}
SAGUARO_VM_ID=$(python3 -c "
import psutil
import re

# Identify the qemu processes
qemu_processes = []
try:
    for process in psutil.process_iter(['pid', 'name', 'cmdline']):
        if 'qemu' in process.info['name']:
            qemu_processes.append(process)
except Exception:
    sys.exit('Exception while iterating over system processes.')

# Identify the occupied guest-cids
used_cids = set()
for process in qemu_processes:
    pid = process.info['pid']
    cmdline = ' '.join(process.info['cmdline'] or [])
    match = re.search(r'guest-cid=(\d+)', cmdline)
    guest_cid = int(match.group(1)) if match else None
    if guest_cid is not None:
        used_cids.add(guest_cid)

# Identify the next available Gramine VM ID based on the uniquely assigned vsock guest-cid.
cid = "$DEFAULT_GRAMINE_VM_ID"
while cid in used_cids:
    cid += 1

# Check that the guest-cid is in a valid range
if cid > 2 and cid < 0xffffffff:
    print(cid)
else:
    sys.exit('Invalid chosen CID value: ' + str(cid) + '. It must be > 2 and < 0xffffffff.')
" 2>&1)
EXIT_STATUS=$?

if [ $EXIT_STATUS -ne 0 ]; then
    echo "Error: Python script for determining the Gramine-VM ID exited with a non-zero status: $EXIT_STATUS"
    echo "Error message: $SAGUARO_VM_ID"
    exit $EXIT_STATUS
fi

# The console is stdio, with a log copy so the guest's exit code can be recovered afterwards: the
# guest ends with a triple fault, so QEMU's own exit status says nothing about the application.
CONSOLE_LOG=$(mktemp /tmp/saguaro-vm-console.XXXXXX)
# The serial port (COM1) gets what the guest logs before its console is up (boot stamps, early
# errors); it is shown only when the guest ends without reporting an exit code.
SERIAL_LOG=$(mktemp /tmp/saguaro-vm-serial.XXXXXX)
XPROXY_LOG=
cleanup() {
    rm -f "$CONSOLE_LOG" "$SERIAL_LOG" ${XPROXY_LOG:+"$XPROXY_LOG"}
    [ -n "${VIRTIOFSD_PID:-}" ] && kill "$VIRTIOFSD_PID" 2>/dev/null
    # the X proxy forks one child per connection; stop those along with the listener
    if [ -n "${XPROXY_PID:-}" ]; then
        pkill -P "$XPROXY_PID" 2>/dev/null
        kill "$XPROXY_PID" 2>/dev/null
        wait "$XPROXY_PID" 2>/dev/null
    fi
    # the vsock relay (see vm-relay.sh): stop it and surface what it logged after startup
    vm_relay_stop
}
trap cleanup EXIT
trap 'exit 130' INT TERM
QEMU_VIRTIO_CONSOLE="-device virtio-serial,iommu_platform=off,romfile= \
-chardev stdio,id=virtioconsole0,logfile=$CONSOLE_LOG \
-device virtconsole,chardev=virtioconsole0 -serial file:$SERIAL_LOG"
QEMU_VIRTIO_FS="-chardev socket,path=/tmp/gramine_vhostfs_"$SAGUARO_VM_ID",id=vhostfs \
-device vhost-user-fs-pci,iommu_platform=off,queue-size=1024,chardev=vhostfs,tag=graminefs"
QEMU_VIRTIO_VSOCK="-device vhost-vsock-pci,iommu_platform=off,guest-cid="$SAGUARO_VM_ID",id=vsockdev"

# The guest splits this string on whitespace but keeps "double-quoted" tokens whole (no escapes), so
# quote every argument: `saguaro-vm app -c "echo hi"` must reach the app as two arguments.
SAGUARO_ARGS="-gramine-args init \"$APPLICATION\""
for arg in "$@"; do
    SAGUARO_ARGS+=" \"$arg\""
done
SAGUARO_ARGS+=" -gramine-args-end"
# Due to QEMU syntax, commas in the QEMU cmdline need to be escaped using an additional comma.
SAGUARO_ARGS=${SAGUARO_ARGS//","/",,"}

# Size (in bytes) of the graphics GEM data arena; set and validated in the graphics block above,
# empty for non-graphics applications.
GRAPHICS_DATA_BYTES=${GRAPHICS_DATA_BYTES:-""}

SAGUARO_ENVS=$(python3 -c "
import os
env_str = ''
for name, value in os.environ.items():
    env_str += ('\"{0}={1}\" '.format(name, value).replace(',', ',,'))
print(env_str)
")
SAGUARO_ENVS="-gramine-envs $SAGUARO_ENVS -gramine-envs-end"

CMD=("${ENVS[@]}")
CMD+=("${PREFIX[@]}")
CMD+=($QEMU_PATH $QEMU_GDB $QEMU_VM $QEMU_OPTS $QEMU_MACHINE
    $QEMU_VIRTIO_CONSOLE $QEMU_VIRTIO_FS $QEMU_VIRTIO_VSOCK $QEMU_BINARIES
    -fw_cfg name=opt/gramine/pwd,string="$PWD"
    -fw_cfg name=opt/gramine/args,string="$SAGUARO_ARGS"
    -fw_cfg name=opt/gramine/envs,string="$SAGUARO_ENVS"
-fw_cfg name=opt/gramine/unixtime_s,string="$EPOCHSECONDS")

# The graphics data-arena size, passed to the PAL over fw_cfg so that the arenas are reserved
# before the guest's boot-time allocator runs (the manifest is not readable that early).
if [ -n "$GRAPHICS_DATA_BYTES" ]; then
    CMD+=("-fw_cfg" "name=opt/gramine/graphics_data_size,string=$GRAPHICS_DATA_BYTES")
    CMD+=("-fw_cfg" "name=opt/gramine/graphics_data_addr,string=$GRAPHICS_DATA_ADDR")
    CMD+=("-fw_cfg" "name=opt/gramine/graphics_huge_addr,string=$GRAPHICS_HUGE_ADDR")
fi

# X proxy for graphics applications. A manifest that sets `loader.env.DISPLAY = "2:N"` points the
# application at the X server of the host (vsock CID 2), which the guest reaches on vsock port
# 6000+N. Relay that port to the X socket named by this launcher's own DISPLAY for as long as the VM
# runs. SAGUARO_VM_X_PROXY=0 disables this (e.g. when the relay runs elsewhere), and
# SAGUARO_VM_X_DISPLAY names another local display. A listener that is already there is reused and
# left running.
X_DISPLAY_NUM=$(python3 -c "
import os, re, sys
try:
    import tomli as tomllib
except ImportError:
    import tomllib
try:
    with open(os.environ['SAGUARO_MANIFEST'], 'rb') as f:
        display = tomllib.load(f).get('loader', {}).get('env', {}).get('DISPLAY', '')
except Exception:
    sys.exit(0)
if isinstance(display, dict):
    display = display.get('value', '')
m = re.fullmatch(r'2:(\\d+)(\\.\\d+)?', str(display))
if m:
    print(m.group(1))
" 2>/dev/null)
if [ -n "$X_DISPLAY_NUM" ] && [ "${SAGUARO_VM_X_PROXY:-1}" != "0" ]; then
    XPROXY_PORT=$((6000 + X_DISPLAY_NUM))
    HOST_DISPLAY=${SAGUARO_VM_X_DISPLAY:-$DISPLAY}
    if [[ ! "$HOST_DISPLAY" =~ ^(unix)?:([0-9]+)(\.[0-9]+)?$ ]]; then
        echo "Error: the manifest uses the host display (DISPLAY=2:$X_DISPLAY_NUM) but this" \
             "environment has no local X display (DISPLAY='$HOST_DISPLAY')." >&2
        echo "Set DISPLAY or SAGUARO_VM_X_DISPLAY to a local display such as :0, or set" \
             "SAGUARO_VM_X_PROXY=0 and provide the vsock relay yourself." >&2
        exit 2
    fi
    HOST_X_SOCKET=/tmp/.X11-unix/X${BASH_REMATCH[2]}
    if command -v ss >/dev/null 2>&1 \
            && ss -H -ln --vsock "sport = :$XPROXY_PORT" 2>/dev/null | grep -q .; then
        echo "saguaro-vm: using the X proxy already listening on vsock port $XPROXY_PORT" >&2
    else
        if ! command -v socat >/dev/null 2>&1; then
            echo "Error: socat is needed to relay the application's X connection" \
                 "(vsock port $XPROXY_PORT -> $HOST_X_SOCKET)." >&2
            exit 2
        fi
        if [ ! -S "$HOST_X_SOCKET" ]; then
            echo "Error: the X socket $HOST_X_SOCKET does not exist (DISPLAY='$HOST_DISPLAY')." >&2
            exit 2
        fi
        XPROXY_LOG=$(mktemp /tmp/saguaro-vm-xproxy.XXXXXX)
        socat -b 1048576 "VSOCK-LISTEN:$XPROXY_PORT,fork,reuseaddr,max-children=50" \
            "UNIX-CONNECT:$HOST_X_SOCKET" >"$XPROXY_LOG" 2>&1 &
        XPROXY_PID=$!
        # wait until it listens (or has failed) before booting the guest
        for _ in $(seq 30); do
            kill -0 "$XPROXY_PID" 2>/dev/null || break
            if command -v ss >/dev/null 2>&1; then
                ss -H -ln --vsock "sport = :$XPROXY_PORT" 2>/dev/null | grep -q . && break
            fi
            sleep 0.1
        done
        if ! kill -0 "$XPROXY_PID" 2>/dev/null; then
            echo "Error: could not start the X proxy on vsock port $XPROXY_PORT:" >&2
            grep -v '/dev/vsock' "$XPROXY_LOG" >&2
            XPROXY_PID=
            exit 2
        fi
    fi
fi

# The vsock relay (dev docs: CHANGELOG.md): one relay process per VM, listening on vsock
# port 65536+CID, started here (after the guest CID is known) and stopped with the VM. It handles
# outbound destination handshakes and static inbound forwarding. Every `vm.net.inbound` rule of the
# manifest (or every rule in the colon-separated SAGUARO_VM_INBOUND="guest:host,..." convenience
# variable, for drivers that cannot edit the manifest) gets a host (container) TCP listener bridged
# into the guest. The manifest is passed to the relay for vm.net.outbound and vm.net.deny policy.
# SAGUARO_VM_RELAY=0 disables the relay entirely. A host port that cannot be bound is an error and
# fails the run, as agreed in the plan.
# The relay does not touch the graphics direct port mapping (guest TCP port N == host vsock port
# N, ports 6000+N and friends): that mapping needs no listener on the host side at all -- the host
# connects directly to the guest's vsock port, the way the X proxy above does.
vm_relay_start "$SAGUARO_VM_ID" "$SAGUARO_MANIFEST" || exit 2

# Check if the Gramine vhostfs pid file is already in use by another process
if lsof /tmp/gramine_vhostfs_"$SAGUARO_VM_ID".pid 2>/dev/null; then
    echo "Error: /tmp/gramine_vhostfs_"$SAGUARO_VM_ID".pid is already in use."
    exit 2
fi
# A stripped environment (the LibOS regression tests pass `env=`, which wipes PATH) leaves bash's
# built-in default PATH, which lacks the distro's virtiofsd directories (Debian/Ubuntu install it
# as QEMU's helper /usr/lib/qemu/virtiofsd, Fedora under /usr/libexec). Find it explicitly; the
# VIRTIOFSD variable overrides the lookup, the same way QEMU_PATH overrides the QEMU binary.
VIRTIOFSD=${VIRTIOFSD:-$(command -v virtiofsd || true)}
[ -n "$VIRTIOFSD" ] || VIRTIOFSD=$(ls /usr/lib/qemu/virtiofsd /usr/libexec/virtiofsd 2>/dev/null | head -n 1)
if [ -z "$VIRTIOFSD" ] || [ ! -x "$VIRTIOFSD" ]; then
    echo "Error: virtiofsd not found in PATH, /usr/lib/qemu or /usr/libexec (set VIRTIOFSD to its path)." >&2
    exit 2
fi
# --xattr: extended attributes of host files reach the guest (the PAL's FUSE_*XATTR requests);
# without it virtiofsd answers ENOSYS and the xattr calls report EOPNOTSUPP.
"$VIRTIOFSD" --socket-path /tmp/gramine_vhostfs_"$SAGUARO_VM_ID" --shared-dir / --log-level error \
--sandbox none --no-announce-submounts --xattr &
VIRTIOFSD_PID=$!
# bounded, so a virtiofsd that died at startup is an error here and not a hang until the test timeout
for _ in $(seq 100); do [ -e /tmp/gramine_vhostfs_"$SAGUARO_VM_ID" ] && break; sleep 0.1; done
if [ ! -e /tmp/gramine_vhostfs_"$SAGUARO_VM_ID" ]; then
    echo "Error: virtiofsd ($VIRTIOFSD) did not create its socket /tmp/gramine_vhostfs_$SAGUARO_VM_ID." >&2
    kill "$VIRTIOFSD_PID" 2>/dev/null
    exit 2
fi

# (not `exec`: the exit code has to be recovered from the console log after QEMU is gone)
env "${CMD[@]}"
QEMU_RC=$?

[ -n "$SAGUARO_VM_CONSOLE_LOG" ] && cp "$CONSOLE_LOG" "$SAGUARO_VM_CONSOLE_LOG" 2>/dev/null
[ -n "$SAGUARO_VM_SERIAL_LOG" ] && cp "$SERIAL_LOG" "$SAGUARO_VM_SERIAL_LOG" 2>/dev/null

# `_PalProcessExit` logs "[ VM exited with code N ]" just before the guest triple-faults (QEMU then
# exits 0 because of -no-reboot, whatever the application did).
GUEST_RC=$(sed -n 's/.*VM exited with code \([0-9]*\).*/\1/p' "$CONSOLE_LOG" 2>/dev/null | tail -1)
if [ -n "$GUEST_RC" ]; then
    exit "$GUEST_RC"
elif grep -q "Panic" "$CONSOLE_LOG" 2>/dev/null; then
    exit 134            # kernel panic before the guest could report an exit code
fi
# No exit code and no panic: the guest died (a triple fault, which QEMU reports as a clean exit) or
# QEMU failed. Not a success, whatever QEMU's status: say so, with the end of the serial output.
{
    echo "Error: the guest ended without reporting an exit code (QEMU exit status $QEMU_RC)."
    if [ -s "$SERIAL_LOG" ]; then
        echo "Last guest serial output:"
        tail -n 20 "$SERIAL_LOG"
        echo
    else
        echo "The guest wrote nothing to its serial port."
    fi
} >&2
[ "$QEMU_RC" -ne 0 ] && exit "$QEMU_RC"
exit 125

"""gramine-vbs: from a manifest to an application running in a Windows VBS enclave.

The work is split between two machines (dev docs: vbs-enclave/manual.md):

* the Linux side (this script): packs the vbs PAL, the LibOS, the vDSO, the manifest and the
  application's files (`vbs.packed_files`) into the image contents (scripts/vbs/pack.py) and
  compiles the Windows enclave runtime and host with clang (scripts/vbs/build-objs.sh);
* the Windows side, over ssh: links, `veiid`s and test-signs the enclave DLL and builds the host
  (scripts/vbs/link-sign.cmd), then runs the application with pal_vbs_host.exe.

Commands:
  gramine-vbs <program> [args]              run a packaged program (made by `make VBS=1` in its
                                            folder), like `gramine-vm <program>`; <program> is a
                                            name, <name>.manifest.vbs or <name>.vbs; the exit code
                                            is the program's. The Windows runner (gramine-vbs.ps1)
                                            is called through powershell.exe.
  gramine-vbs run    <program|dir> [--threads N] [--root DIR] [-v] [-- args]   the same, explicit
  gramine-vbs check                         check the Windows side (changes nothing there)
  gramine-vbs stop   <program|dir>          stop the running hosts of a package on Windows
  gramine-vbs verify <program|dir> <report> [verifier options]   (report: a Windows path, or
                                            relative to the host root, e.g. data/out/report.bin)
  gramine-vbs manifest [-Dk=v ...] <template> [out]   render a manifest template (Jinja, as
                                            gramine-manifest, with the vbs.* globals)
  gramine-vbs runtime                       build the vbs glibc and the vbs PAL and LibOS when
                                            missing, then ninja (scripts/vbs/build-runtime.sh)
  gramine-vbs net <wait|req|redis|bench> ...   a Winsock client on Windows (scripts/vbs/win/
                                            vbs-net.c, compiled there once with MSVC)
  gramine-vbs tls-client PORT --verifier DIR.vbs ...   a TLS client on Windows that verifies the
                                            server's attestation first (scripts/vbs/win/
                                            vbs-tls-client.c; CI-Examples/vbs/tls-echo)
  gramine-vbs win <program> [args]          run a program on the Windows side (e.g. curl.exe)
  gramine-vbs setup-headers                 copy the Windows SDK and MSVC headers from Windows

Building is `make VBS=1` (scripts/vbs/Makefile.vbs), which uses these internal steps:
  gramine-vbs build  <manifest>             pack and compile; with a Windows target also sign
  gramine-vbs sign   <manifest|build dir>   upload, link and sign on Windows

Settings (options override the environment):
  --runtime DIR / GRAMINE_VBS_RUNTIME     the meson build directory of `-Dvbs=enabled` (or a folder
                                          with libpal.so, libsysdb.so and vdso.so)
  --headers DIR / GRAMINE_VBS_HEADERS     the copied Windows headers (default
                                          ~/.cache/gramine-vbs/winhdr; see setup-headers)
  --windows HOST / GRAMINE_VBS_WINDOWS    ssh destination of the Windows machine; "local": the
                                          Windows of this machine, from WSL through interop
                                          (powershell.exe and /mnt paths; the default in WSL
                                          when interop works); "none": no Windows side
  --windows-dir DIR / GRAMINE_VBS_WINDOWS_DIR   folder on Windows (default
                                          <base>\\<name>, and <base>\\<name>-<hash> for local)
  GRAMINE_VBS_WINDOWS_BASE                the base of those folders (default
                                          %USERPROFILE%\\gramine-vbs, local: ...\\gramine-vbs\\wsl)
  --cert-name NAME / GRAMINE_VBS_CERT_NAME      signing certificate (current user's store; default
                                          TheDefaultTestEnclaveCertName)
  GRAMINE_VBS_SSH_OPTS                    extra ssh/scp options, e.g. "-o BatchMode=yes"
"""

import argparse
import base64
import fnmatch
import hashlib
import json
import os
import platform
import shlex
import shutil
import signal
import subprocess
import sys
import time
import tomllib

HERE = os.path.dirname(os.path.realpath(__file__))   # (gramine-vbs on PATH is a symlink)
ROOT = os.path.dirname(os.path.dirname(HERE))
# the architecture of the Linux side and of the enclave image: aarch64 (ARM64 Windows) or x86_64
# (x64 Windows, dev docs: vbs-enclave/PLAN-x64.md); GRAMINE_VBS_ARCH overrides
ARCH = os.environ.get('GRAMINE_VBS_ARCH') or ('x86_64' if platform.machine() in ('x86_64', 'AMD64')
                                              else 'aarch64')
ELF_MACHINE = 62 if ARCH == 'x86_64' else 183

# objects of the runtime: (pack name, kind, file name, possible places in a meson build dir, path)
RUNTIME = [
    ('libpal', 'pal', 'libpal.so', ['pal/src/host/vbs/libpal.so'], None),
    ('libsysdb', 'pal', 'libsysdb.so', ['libos/src/libsysdb.so'], '/libsysdb.so'),
    ('vdso', 'user', 'vdso.so', [f'libos/src/vdso/arch/{ARCH}/vdso.so'], '/gramine/vdso.so'),
]
# functions of the vbs glibc (scripts/vbs/build-glibc.sh) that may use x18: they save and restore
# it or run only where the TEB is not needed (see FINDINGS.md of dev docs: vbs-enclave)
X18_DEFAULTS = {
    'libsysdb.so': ['libos_syscall_entry', '_return_from_syscall'],
    'ld-linux-aarch64.so.1': ['_dl_tlsdesc_dynamic'],
    'libc.so.6': ['getcontext', 'swapcontext'],
} if ARCH == 'aarch64' else {}   # x86_64 has no x18


def die(msg):
    sys.exit(f'gramine-vbs: {msg}')


def log(msg):
    print(f'[gramine-vbs] {msg}', flush=True)


# ---- settings ----

def setting(args, name, env, default=None):
    v = getattr(args, name, None)
    return v if v else os.environ.get(env, default)


def ssh_opts():
    return shlex.split(os.environ.get('GRAMINE_VBS_SSH_OPTS', ''))


LOCAL = 'local'   # the Windows of this machine, reached from WSL through interop


def powershell_exe():
    """powershell.exe of this machine when running in WSL with interop, else None"""
    if not any(os.path.exists(f'/proc/sys/fs/binfmt_misc/{n}')
               for n in ('WSLInterop', 'WSLInterop-late')):
        return None
    p = shutil.which('powershell.exe')
    if not p:
        for c in ('/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe',
                  '/mnt/c/WINDOWS/System32/WindowsPowerShell/v1.0/powershell.exe'):
            if os.path.isfile(c):
                p = c
                break
    return p


def windows_target(args):
    """the configured Windows side: an ssh destination, LOCAL, or None"""
    h = setting(args, 'windows', 'GRAMINE_VBS_WINDOWS')
    if h == 'none':
        return None
    if h:
        return h
    return LOCAL if powershell_exe() else None


def windows_host(args):
    h = windows_target(args)
    if not h:
        die('no Windows machine: give --windows HOST or set GRAMINE_VBS_WINDOWS (in WSL, the '
            'Windows of the same machine is used when interop works)')
    if h == LOCAL and not powershell_exe():
        die('--windows local needs WSL with interop (powershell.exe)')
    return h


def wslpath(p):
    """the WSL path of a Windows path (local transport)"""
    return subprocess.run(['wslpath', '-u', p], check=True, capture_output=True,
                          text=True).stdout.strip()


# ---- the Windows side: over ssh (the remote shell is PowerShell or cmd: commands go as
# -EncodedCommand), or locally from WSL through powershell.exe ----

def ps_popen(host, script):
    pre = "$ProgressPreference = 'SilentlyContinue'; $ErrorActionPreference = 'Continue'\n"
    enc = base64.b64encode((pre + script).encode('utf-16-le')).decode()
    if host == LOCAL:
        exe = powershell_exe()
        cmd = [exe, '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass',
               '-EncodedCommand', enc]
        cwd = os.path.dirname(exe)   # a Windows folder (not a \\wsl$ path)
    else:
        cmd = ['ssh', *ssh_opts(), host,
               f'powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand {enc}']
        cwd = None
    return subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            stdin=subprocess.DEVNULL, text=True, errors='replace', cwd=cwd)


def consume(p, host, check=True, capture=False, on_line=None):
    """Reads the lines of a started Windows process; returns (exit code, output). on_line(line)
    may consume a line (return True)."""
    out = []
    for line in p.stdout:
        line = line.rstrip('\r\n')
        if line.startswith('#< CLIXML') or line.startswith('<Objs'):
            continue
        if on_line and on_line(line):
            continue
        out.append(line)
        if not capture:
            print(line, flush=True)
    rc = p.wait()
    if check and rc:
        die(f'the command on {host} failed (exit {rc})')
    return rc, '\n'.join(out)


def ps(host, script, check=True, capture=False, on_line=None):
    """Runs a PowerShell script on the Windows machine; returns (exit code, output)."""
    return consume(ps_popen(host, script), host, check, capture, on_line)


def runner_popen(host, windir, argv):
    """Starts the Windows-side runner (gramine-vbs.ps1, uploaded to `windir` by `sign`) with
    `argv`: through powershell.exe -File from WSL, or over ssh."""
    script = windir + '\\gramine-vbs.ps1'
    if host == LOCAL:
        exe = powershell_exe()
        return subprocess.Popen([exe, '-NoProfile', '-NonInteractive', '-ExecutionPolicy',
                                 'Bypass', '-File', script, *argv], stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, text=True,
                                errors='replace', cwd=os.path.dirname(exe))
    env = f"$env:GRAMINE_VBS_ARGS = {psq(os.environ['GRAMINE_VBS_ARGS'])}\n" \
        if os.environ.get('GRAMINE_VBS_ARGS') else ''
    return ps_popen(host, env + '& powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass '
                          f'-File {psq(script)} ' + ' '.join(psq(a) for a in argv) +
                    '\nexit $LASTEXITCODE')


def psq(s):
    """a PowerShell single-quoted string"""
    return "'" + str(s).replace("'", "''") + "'"


def windows_dir(args, host, name, b=None, explicit=True):
    d = setting(args, 'windows_dir', 'GRAMINE_VBS_WINDOWS_DIR') if explicit else None
    if d:
        return d.rstrip('\\/')
    base = os.environ.get('GRAMINE_VBS_WINDOWS_BASE')
    if not base:
        _, out = ps(host, 'Write-Output $env:USERPROFILE', capture=True)
        base = out.strip().splitlines()[-1] + '\\gramine-vbs' + ('\\wsl' if host == LOCAL else '')
    base = base.rstrip('\\/')
    if host == LOCAL and b is not None:
        # several checkouts and examples share one Windows: one folder per Linux build folder
        name += '-' + hashlib.sha256(b.dir.encode()).hexdigest()[:8]
    return base + '\\' + name


def scp_path(host, path):
    p = path.replace('\\', '/')
    return f'{host}:"{p}"' if ' ' in p else f'{host}:{p}'


def upload(host, files, windir):
    if host == LOCAL:
        d = wslpath(windir)
        os.makedirs(d, exist_ok=True)
        for f in files:
            shutil.copyfile(f, os.path.join(d, os.path.basename(f)))
        return
    ps(host, f'New-Item -ItemType Directory -Force -Path {psq(windir)} | Out-Null', capture=True)
    subprocess.run(['scp', '-q', *ssh_opts(), *files, scp_path(host, windir + '/')], check=True)


def download(host, winfile, local):
    if host == LOCAL:
        shutil.copyfile(wslpath(winfile), local)
    else:
        subprocess.run(['scp', '-q', *ssh_opts(), scp_path(host, winfile), local], check=True)


# ---- the build directory ----

class Build:
    def __init__(self, target, out=None):
        if os.path.isdir(target):
            self.dir = os.path.abspath(target)
            st = self.load()
            if not st:
                die(f'{target} is not a gramine-vbs build directory')
            self.manifest = st['manifest']
        else:
            if target.rstrip('/').endswith('.vbs') and not os.path.isfile(target):
                die(f'{target} does not exist: build it first (gramine-vbs build <manifest>)')
            self.manifest = os.path.abspath(target)
            stem = os.path.basename(self.manifest)
            for suffix in ('.manifest.toml', '.manifest.vbs', '.manifest'):
                if stem.endswith(suffix):
                    stem = stem[:-len(suffix)]
                    break
            self.dir = os.path.abspath(out or os.path.join(os.path.dirname(self.manifest),
                                                           stem + '.vbs'))
        self.name = os.path.basename(self.dir)[:-4] if self.dir.endswith('.vbs') \
            else os.path.basename(self.dir)

    @property
    def state_file(self):
        return os.path.join(self.dir, 'build.json')

    def load(self):
        try:
            with open(self.state_file) as f:
                return json.load(f)
        except (OSError, ValueError):
            return None

    def save(self, **kw):
        st = self.load() or {}
        st.update(kw)
        os.makedirs(self.dir, exist_ok=True)
        with open(self.state_file, 'w') as f:
            json.dump(st, f, indent=1)


def default_headers():
    """~/.cache/gramine-vbs/winhdr (setup-headers), or the newest copy that gramine-vbs.ps1 left
    in ~/.cache/gramine-vbs/winhdr/<SDK>-<MSVC> (a WSL distribution used by the Windows tool)"""
    base = os.path.expanduser('~/.cache/gramine-vbs/winhdr')
    if os.path.isdir(os.path.join(base, 'sdk', 'um')):
        return base
    try:
        found = sorted(d for d in os.listdir(base)
                       if os.path.isfile(os.path.join(base, d, '.complete'))
                       and os.path.isdir(os.path.join(base, d, 'sdk', 'um')))
    except OSError:
        found = []
    return os.path.join(base, found[-1]) if found else base


def find_runtime(rt):
    if not rt:
        rt = os.path.join(ROOT, 'build-vbs')
    found = {}
    for name, _, fname, places, _ in RUNTIME:
        for c in [fname] + places:
            p = os.path.join(rt, c)
            if os.path.isfile(p):
                found[name] = p
                break
        else:
            die(f'{fname} not found in the runtime directory {rt} (--runtime): build Gramine with '
                f'`meson setup build-vbs -Dvbs=enabled ...` on an {ARCH} Linux machine')
    return found


def is_packable_elf(path):
    """an ELF shared object or PIE (ET_DYN) of the image's architecture: packed as a loadable
    object"""
    try:
        with open(path, 'rb') as f:
            h = f.read(20)
    except OSError:
        return False
    return (len(h) == 20 and h[:4] == b'\x7fELF' and h[4] == 2 and h[16] == 3 and h[17] == 0
            and int.from_bytes(h[18:20], 'little') == ELF_MACHINE)


def packed_entries(manifest, m):
    """(source, path in the enclave) of every packed file, from vbs.packed_files"""
    base = os.path.dirname(manifest)
    out = []
    for e in m.get('vbs', {}).get('packed_files', []):
        if isinstance(e, str):
            e = {'uri': e}
        uri = e.get('uri', '')
        if not uri.startswith('file:'):
            die(f'vbs.packed_files: {uri!r} is not a "file:" URI')
        src = os.path.join(base, uri[len('file:'):])
        path = e.get('path') or ('/' + os.path.basename(src.rstrip('/')))
        excl = e.get('exclude', [])
        if os.path.isdir(src):
            for d, dirs, files in os.walk(src):
                rel_d = os.path.relpath(d, src)
                dirs[:] = sorted(x for x in dirs if not any(
                    fnmatch.fnmatch(os.path.normpath(os.path.join(rel_d, x)) + '/', pat)
                    or fnmatch.fnmatch(x + '/', pat) for pat in excl))
                for fn in sorted(files):
                    rel = os.path.normpath(os.path.join(rel_d, fn))
                    if any(fnmatch.fnmatch(rel, p) or fnmatch.fnmatch(fn, p) for p in excl):
                        continue
                    out.append((os.path.join(d, fn), path.rstrip('/') + '/' + rel))
        elif os.path.isfile(src):
            out.append((src, path))
        else:
            die(f'vbs.packed_files: {src} does not exist')
    return out


def run_recipe(b, recipe):
    """vbs.build: a shell command that builds the application's files, run in the manifest's
    folder before packing, with the compilers for the enclave in the environment"""
    if not isinstance(recipe, str):
        die('vbs.build must be a string (a shell command)')
    sysroot = os.environ.get('GRAMINE_VBS_SYSROOT', os.path.join(ROOT, 'build-vbs-glibc'))
    if not os.path.isfile(os.path.join(sysroot, 'usr', 'lib', 'libc.so.6')):
        die(f'vbs.build needs the vbs glibc in {sysroot} (scripts/vbs/build-glibc.sh, or set '
            f'GRAMINE_VBS_SYSROOT)')
    env = dict(os.environ, SYSROOT=sysroot, GRAMINE_REPO=ROOT,
               VBS_CC_STATIC=os.path.join(HERE, 'cc-static-pie.sh'),
               VBS_CC_DYNAMIC=os.path.join(HERE, 'cc-dynamic-pie.sh'),
               VBS_GCC=os.path.join(HERE, 'vbs-gcc'))
    log(f'vbs.build: {recipe}')
    t0 = time.monotonic()
    os.makedirs(b.dir, exist_ok=True)
    with open(os.path.join(b.dir, 'recipe.log'), 'w') as lf:
        r = subprocess.run(['sh', '-c', recipe], cwd=os.path.dirname(b.manifest), env=env,
                           stdout=lf, stderr=subprocess.STDOUT)
    if r.returncode:
        sys.stdout.write(open(os.path.join(b.dir, 'recipe.log')).read()[-3000:])
        die(f'vbs.build failed (exit {r.returncode}, recipe.log)')
    log(f'vbs.build: {time.monotonic() - t0:.1f} s')


def cmd_build(args):
    b = Build(args.target, args.output)
    if not os.path.isfile(b.manifest):
        die(f'no manifest {b.manifest}')
    try:
        with open(b.manifest, 'rb') as f:
            m = tomllib.load(f)
    except tomllib.TOMLDecodeError as e:
        die(f'{b.manifest}: {e} (TOML 1.0: inline tables stay on one line)')
    if m.get('sys', {}).get('rewrite_syscalls') is not False:
        die('the manifest must say sys.rewrite_syscalls = false (no run-time code in an enclave)')
    if m.get('loader', {}).get('entrypoint') != 'file:/libsysdb.so':
        die('the manifest must say loader.entrypoint = "file:/libsysdb.so" (the packed LibOS)')
    entry = m.get('libos', {}).get('entrypoint')
    if not entry:
        die('the manifest has no libos.entrypoint')

    recipe = m.get('vbs', {}).get('build')
    if recipe:
        run_recipe(b, recipe)

    rt = find_runtime(setting(args, 'runtime', 'GRAMINE_VBS_RUNTIME'))
    hdr = setting(args, 'headers', 'GRAMINE_VBS_HEADERS') or default_headers()
    if not os.path.isdir(os.path.join(hdr, 'sdk', 'um')):
        if not setting(args, 'headers', 'GRAMINE_VBS_HEADERS') and windows_target(args):
            log('no Windows headers yet: copying them from Windows (once)')
            cmd_setup_headers(args)
            hdr = default_headers()
        else:
            die(f'no Windows headers in {hdr}: run `gramine-vbs setup-headers` (or give --headers)')

    files = packed_entries(b.manifest, m)
    paths = [p for _, p in files]
    if entry not in paths:
        die(f'libos.entrypoint {entry} is not among vbs.packed_files')
    if len(set(paths)) != len(paths):
        die('vbs.packed_files gives a path twice')

    pack_dir = os.path.join(b.dir, 'pack')
    obj_dir = os.path.join(b.dir, 'obj')
    shutil.rmtree(pack_dir, ignore_errors=True)
    shutil.rmtree(obj_dir, ignore_errors=True)
    os.makedirs(b.dir, exist_ok=True)

    a = []
    for name, kind, fname, _, path in RUNTIME:
        a += ['--obj', f'{kind}:{name}:{rt[name]}' + (f':{path}' if path else '')]
    a += ['--no-svc', 'libpal']
    x18 = {k: list(v) for k, v in X18_DEFAULTS.items()}
    for k, v in m.get('vbs', {}).get('x18_allow', {}).items():
        x18.setdefault(os.path.basename(k), []).extend(v)
    names = {'libsysdb.so': 'libsysdb'}
    nobj = nfile = 0
    for src, path in files:
        if is_packable_elf(src):
            nobj += 1
            name = f'o{nobj}'
            names.setdefault(os.path.basename(path), name)
            a += ['--obj', f'user:{name}:{src}:{path}']
        else:
            nfile += 1
            a += ['--file', f'f{nfile}:{src}:{path}']
    for base, funcs in x18.items():
        if base in names and funcs:
            a += ['--x18-allow', f'{names[base]}:{",".join(funcs)}']
    # constructors that reach x18 and that the application does not need (pack.py, "x18")
    skip = m.get('vbs', {}).get('x18_skip_constructors', [])
    if not isinstance(skip, list) or not all(isinstance(x, str) for x in skip):
        die('vbs.x18_skip_constructors must be a list of packed object names')
    for base in skip:
        if os.path.basename(base) not in names:
            die(f'vbs.x18_skip_constructors: {base} is not a packed object')
        a += ['--x18-skip-constructors', names[os.path.basename(base)]]
    a += ['--file', f'manifest:{b.manifest}:/{b.name}.manifest']
    argfile = os.path.join(b.dir, 'pack-args.txt')
    with open(argfile, 'w') as f:
        f.write('\n'.join(a) + '\n')
    log(f'pack: {nobj} objects, {nfile} files (+ the runtime and the manifest) -> {pack_dir}')
    with open(os.path.join(b.dir, 'pack.log'), 'w') as lf:
        r = subprocess.run([sys.executable, '-I', os.path.join(HERE, 'pack.py'), '--out', pack_dir,
                            '@' + argfile], stdout=lf, stderr=subprocess.STDOUT)
    if r.returncode:
        sys.stdout.write(open(os.path.join(b.dir, 'pack.log')).read()[-3000:])
        die('pack.py failed (pack.log)')
    for line in open(os.path.join(b.dir, 'pack.log')):
        if line.startswith('enclave configuration') or line.startswith('images '):
            log(line.strip())

    log(f'Windows objects (clang) -> {obj_dir}')
    env = dict(os.environ, HDR=hdr, OUT=obj_dir, PACK=pack_dir, VBS_ARCH=ARCH)
    with open(os.path.join(b.dir, 'objs.log'), 'w') as lf:
        r = subprocess.run(['sh', os.path.join(HERE, 'build-objs.sh')], env=env, stdout=lf,
                           stderr=subprocess.STDOUT)
    if r.returncode:
        sys.stdout.write(open(os.path.join(b.dir, 'objs.log')).read()[-3000:])
        die('build-objs.sh failed (objs.log)')
    h = hashlib.sha256()
    for fn in sorted(os.listdir(obj_dir)):
        h.update(open(os.path.join(obj_dir, fn), 'rb').read())
    b.save(manifest=b.manifest, name=b.name, objects=h.hexdigest(), signed=None)

    if not args.no_sign and windows_target(args):
        cmd_sign(args, b)
    elif not os.environ.get('GV_OUT'):    # (not when gramine-vbs.ps1 drives the build from WSL)
        log(f'built {b.dir}; `gramine-vbs sign` links and signs it on Windows')


def cmd_sign(args, b=None):
    b = b or Build(args.target)
    st = b.load()
    if not st or not st.get('objects'):
        die(f'{b.dir} is not built (gramine-vbs build)')
    host = windows_host(args)
    windir = windows_dir(args, host, b.name, b)
    obj_dir = os.path.join(b.dir, 'obj')
    files = [os.path.join(obj_dir, f) for f in sorted(os.listdir(obj_dir)) if f.endswith('.obj')]
    # batch files with CRLF line ends (cmd.exe misreads some LF-only constructs)
    crlf = os.path.join(b.dir, 'link-sign.cmd')
    with open(os.path.join(HERE, 'link-sign.cmd'), newline='') as f:
        text = f.read().replace('\r\n', '\n').replace('\n', '\r\n')
    with open(crlf, 'w', newline='') as f:
        f.write(text)
    files += [crlf, os.path.join(ROOT, 'pal/src/host/vbs/enclave/pal_vbs_enclave.def'),
              os.path.join(HERE, 'gramine-vbs.ps1')]
    # the host folders the manifest allows (vbs.allowed_files entries ending in /), made below the
    # host root before each run (gramine-vbs.ps1 run)
    dirs = []
    try:
        with open(st['manifest'], 'rb') as f:
            allowed = tomllib.load(f).get('vbs', {}).get('allowed_files', [])
        dirs = [p.rstrip('/').replace('/', '\\') for p in allowed
                if isinstance(p, str) and p.endswith('/') and p.startswith('/')]
    except (OSError, tomllib.TOMLDecodeError):
        pass
    hd = os.path.join(b.dir, 'host-dirs.txt')
    with open(hd, 'w', newline='') as f:
        f.write(''.join(d + '\r\n' for d in dirs))
    files.append(hd)
    log(f'upload {len(files)} files to {host}:{windir}')
    upload(host, files, windir)
    cert = setting(args, 'cert_name', 'GRAMINE_VBS_CERT_NAME', 'TheDefaultTestEnclaveCertName')
    log(f'link, veiid, sign with the certificate "{cert}" (current user store)')
    rc, out = ps(host, f'''
Set-Location {psq(windir)}
$env:VBS_CERT_NAME = {psq(cert)}
cmd.exe /c "link-sign.cmd > link.log 2>&1"
$rc = $LASTEXITCODE
if ($rc -ne 0 -or -not (Select-String -Quiet -Path link.log -Pattern 'build done')) {{
    Get-Content link.log -Tail 25; exit 1 }}
Copy-Item pal_vbs_enclave.dll {psq(b.name + '.dll')} -Force
Get-Item {psq(b.name + '.dll')}, pal_vbs_host.exe | ForEach-Object {{ "$($_.Name) $($_.Length)" }}
''', check=False, capture=True)
    print(out)
    if rc:
        die('link/sign on Windows failed (link.log there)')
    b.save(signed=st['objects'], windows=host, windows_dir=windir)
    # the package in WSL too: <app>.vbs/<app>.dll next to the objects it was made from
    download(host, f'{windir}\\{b.name}.dll', os.path.join(b.dir, b.name + '.dll'))
    log(f'signed: {windir}\\{b.name}.dll (copy: {os.path.join(b.dir, b.name + ".dll")})')


def cmd_run(args):
    """Runs a packaged application (made by `make VBS=1`); never builds."""
    b = find_package(args.target)
    st = b.load()
    host = setting(args, 'windows', 'GRAMINE_VBS_WINDOWS', st.get('windows'))
    windir = setting(args, 'windows_dir', 'GRAMINE_VBS_WINDOWS_DIR', st.get('windows_dir'))
    argv = ['run', windir, '-Name', b.name, '-Threads', str(int(args.threads)), '-PidLine']
    if args.root:
        argv += ['-Root', args.root]
    if args.verbose:
        argv.append('-ShowHost')
    # the application's arguments travel in an environment variable (JSON, base64), not on the
    # command line: powershell.exe -File and the native-command rules of Windows PowerShell 5.1
    # would otherwise split and unquote them
    if args.args:
        os.environ['GRAMINE_VBS_ARGS'] = base64.b64encode(json.dumps(args.args).encode()).decode()
        if host == LOCAL:
            os.environ['WSLENV'] = ':'.join(filter(None, [os.environ.get('WSLENV'),
                                                          'GRAMINE_VBS_ARGS']))
    # The runner names its own process first: SIGTERM or SIGINT here stops the host process (its
    # child) on Windows, so that scripts can stop a server with `kill` as with gramine-direct.
    pspid = []
    stopped = []

    def on_line(line):
        if line.startswith('[gramine-vbs-pid] '):
            pspid.append(line.split()[1])
            return True
        return False

    def stop(signum, _frame):
        if pspid:
            ps(host, f"Get-CimInstance Win32_Process -Filter 'ParentProcessId={int(pspid[0])}' | "
                     "ForEach-Object { Stop-Process -Id $_.ProcessId -Force "
                     "-ErrorAction SilentlyContinue }", check=False, capture=True)
        stopped.append(signum)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    # settings of the host process that are passed on from this environment (measurement)
    for k in ('GRAMINE_VBS_HOSTCALL_STATS', 'GRAMINE_VBS_TIMER_RES'):
        if os.environ.get(k) and host == LOCAL:
            os.environ['WSLENV'] = ':'.join(filter(None, [os.environ.get('WSLENV'), k]))
    if host == LOCAL:    # the runner of this checkout (a package signed earlier may hold an older one)
        dst = os.path.join(wslpath(windir), 'gramine-vbs.ps1')
        src = os.path.join(HERE, 'gramine-vbs.ps1')
        with open(src, 'rb') as f1, open(dst, 'rb') as f2:
            same = f1.read() == f2.read()
        if not same:
            shutil.copyfile(src, dst)
    rc, _ = consume(runner_popen(host, windir, argv), host, check=False, on_line=on_line)
    sys.exit(128 + stopped[0] if stopped else rc)


def find_package(target):
    """The signed package named by `target`: a program name (<name>.manifest.vbs of this folder), a
    manifest, or a package folder (<name>.vbs). Exits with the instruction to run make VBS=1."""
    t = target[2:] if target.startswith('./') else target
    t = t.rstrip('/')
    if t.endswith('.vbs') and os.path.isdir(t):
        pkg = t
    else:
        stem = t
        for suffix in ('.manifest.vbs', '.manifest.toml', '.manifest'):
            if stem.endswith(suffix):
                stem = stem[:-len(suffix)]
                break
        pkg = stem + '.vbs'
        if not os.path.isfile(stem + '.manifest.vbs') and not os.path.isdir(pkg):
            die(f"no VBS package '{target}' in {os.getcwd()}: build it first with `make VBS=1` "
                f"(in the example's folder)")
    if not os.path.isfile(os.path.join(pkg, 'build.json')):
        die(f"'{target}' is not built: run `make VBS=1` in its folder")
    b = Build(pkg)
    st = b.load()
    if not st or not st.get('signed') or not st.get('windows_dir'):
        die(f"'{target}' is not built and signed: run `make VBS=1` in its folder")
    if os.path.getmtime(b.manifest) > os.path.getmtime(b.state_file):
        die(f"the package of '{target}' is older than {os.path.basename(b.manifest)}: "
            "run `make VBS=1` again")
    return b


def cmd_check(args):
    """Checks the Windows side (VBS, Visual Studio, SDK, certificate) and changes nothing there."""
    host = windows_host(args)
    windir = windows_dir(args, host, 'runner')
    upload(host, [os.path.join(HERE, 'gramine-vbs.ps1')], windir)
    cert = setting(args, 'cert_name', 'GRAMINE_VBS_CERT_NAME', 'TheDefaultTestEnclaveCertName')
    rc, _ = consume(runner_popen(host, windir, ['check', '-CertName', cert]), host, check=False)
    sys.exit(rc)


def build_hosts_script(windir):
    """PowerShell: the pal_vbs_host.exe processes started from a Windows build folder"""
    exe = windir.rstrip('\\') + '\\pal_vbs_host.exe'
    return ("Get-CimInstance Win32_Process -Filter \"Name='pal_vbs_host.exe'\" | "
            f"Where-Object {{ $_.ExecutablePath -eq {psq(exe)} }}")


def cmd_stop(args):
    b = find_package(args.target)
    st = b.load()
    if not st or not st.get('windows_dir'):
        die(f'{b.dir} was not signed on Windows')
    host = setting(args, 'windows', 'GRAMINE_VBS_WINDOWS', st.get('windows'))
    ps(host, build_hosts_script(st['windows_dir']) +
       ' | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue; '
       '"stopped $($_.ProcessId)" }', check=False)


# ---- rendering a manifest template ----

def jinja_env():
    """The Jinja environment of gramine-manifest (python/graminelibos/gen_jinja_env.py), loaded from
    this source tree so that no installed Gramine is needed, plus the vbs.* globals."""
    import importlib.util  # pylint: disable=import-outside-toplevel
    import types  # pylint: disable=import-outside-toplevel
    pkgdir = os.path.join(ROOT, 'python', 'graminelibos')
    pkg = types.ModuleType('graminelibos')
    pkg.__path__ = [pkgdir]
    pkg._CONFIG_LIBC = 'none'
    pkg._CONFIG_PKGLIBDIR = os.path.join(ROOT, 'build-vbs')
    sys.modules['graminelibos'] = pkg
    spec = importlib.util.spec_from_file_location('graminelibos.gen_jinja_env',
                                                  os.path.join(pkgdir, 'gen_jinja_env.py'))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    env = mod.make_env()
    env.globals['vbs'] = {
        'repo': ROOT,                                          # the repository
        'sysroot': os.environ.get('GRAMINE_VBS_SYSROOT',       # the vbs glibc
                                  os.path.join(ROOT, 'build-vbs-glibc')),
        'python': os.path.join(ROOT, 'build-vbs-python'),      # scripts/vbs/build-python.sh
        # the dynamic loader of the vbs glibc (in /usr/lib of the sysroot and of the enclave)
        'ldso': 'ld-linux-x86-64.so.2' if ARCH == 'x86_64' else 'ld-linux-aarch64.so.1',
    }
    return env


def cmd_manifest(args):
    variables = {}
    for d in args.define:
        k, eq, v = d.partition('=')
        variables[k] = v if eq else True
    try:
        env = jinja_env()
    except ImportError as e:
        die(f'rendering needs jinja2 ({e}): python3-jinja2, or `wsl-setup.sh user`')
    with open(args.template) as f:
        text = env.from_string(f.read()).render(**variables)
    try:
        m = tomllib.loads(text)
    except tomllib.TOMLDecodeError as e:
        die(f'{args.template} (rendered): {e}')
    if m.get('sys', {}).get('rewrite_syscalls') is not False:
        die(f'{args.template}: a vbs manifest must say sys.rewrite_syscalls = false')
    if m.get('loader', {}).get('entrypoint') != 'file:/libsysdb.so':
        die(f'{args.template}: a vbs manifest must say loader.entrypoint = "file:/libsysdb.so"')
    if 'sgx' in m:
        die(f'{args.template}: sgx.* keys in a vbs manifest (the vbs PAL reads vbs.*)')
    if args.out and args.out != '-':
        with open(args.out + '.tmp', 'w') as f:
            f.write(text)
        os.replace(args.out + '.tmp', args.out)
    else:
        sys.stdout.write(text)


# ---- the runtime (vbs glibc, PAL, LibOS) ----

def cmd_runtime(_args):
    r = subprocess.run(['sh', os.path.join(HERE, 'build-runtime.sh')], check=False)
    if r.returncode:
        die('building the runtime failed')
    # a stamp that changes only when the runtime objects or the vbs libc changed (for make)
    h = hashlib.sha256()
    rt = find_runtime(os.path.join(ROOT, 'build-vbs'))
    for name in sorted(rt):
        with open(rt[name], 'rb') as f:
            h.update(f.read())
    with open(os.path.join(ROOT, 'build-vbs-glibc', 'usr', 'lib', 'libc.so.6'), 'rb') as f:
        h.update(f.read())
    # the Windows half (enclave runtime, host) and the tools that make an image from them
    srcs = [os.path.join(HERE, n) for n in ('build-objs.sh', 'pack.py', 'link-sign.cmd')]
    for d in ('enclave', 'host', 'common'):
        top = os.path.join(ROOT, 'pal', 'src', 'host', 'vbs', d)
        for dp, _, fns in os.walk(top):
            srcs += [os.path.join(dp, fn) for fn in fns]
    for fn in sorted(srcs):
        h.update(fn.encode())
        with open(fn, 'rb') as f:
            h.update(f.read())
    stamp = os.path.join(ROOT, 'build-vbs', 'runtime.stamp')
    try:
        with open(stamp) as f:
            old = f.read().strip()
    except OSError:
        old = None
    if old != h.hexdigest():
        with open(stamp, 'w') as f:
            f.write(h.hexdigest() + '\n')


# ---- programs on the Windows side ----

def vs_cmd_script(lines):
    """a cmd script that runs `lines` with the MSVC environment of the image's architecture (as
    link-sign.cmd)"""
    return '\r\n'.join([
        '@echo off', 'setlocal',
        'if "%VS_INSTALL_DIR%"=="" for /f "usebackq delims=" %%i in (`"%ProgramFiles(x86)%\\'
        'Microsoft Visual Studio\\Installer\\vswhere.exe" -latest -products * -property '
        'installationPath`) do set VS_INSTALL_DIR=%%i',
        'if "%VS_INSTALL_DIR%"=="" (echo no Visual Studio found & exit /b 1)',
        'set VBS_HOST_ARCH=arm64',
        'if /i "%PROCESSOR_ARCHITECTURE%"=="AMD64" set VBS_HOST_ARCH=x64',
        f'call "%VS_INSTALL_DIR%\\Common7\\Tools\\VsDevCmd.bat" '
        f'-arch={"x64" if ARCH == "x86_64" else "arm64"} -host_arch=%VBS_HOST_ARCH% '
        '-no_logo || exit /b 1', *lines, ''])


def win_tool(args, name):
    """Compiles scripts/vbs/win/<name>.c on Windows once (per source hash); returns (host, exe)"""
    host = windows_host(args)
    src = os.path.join(HERE, 'win', name + '.c')
    with open(src, 'rb') as f:
        tag = hashlib.sha256(f.read()).hexdigest()[:8]
    tools = windows_dir(args, host, 'tools', explicit=False)
    exe = f'{tools}\\{name}-{tag}.exe'
    if host == LOCAL:
        present = os.path.isfile(wslpath(exe))
    else:
        rc, _ = ps(host, f'if (Test-Path {psq(exe)}) {{ exit 0 }} else {{ exit 1 }}', check=False,
                   capture=True)
        present = rc == 0
    if not present:
        log(f'compiling {name}.c with MSVC on Windows ({exe})')
        tmp = os.path.join(os.environ.get('TMPDIR', '/tmp'), f'gramine-vbs-{os.getpid()}')
        os.makedirs(tmp, exist_ok=True)
        cmdf = os.path.join(tmp, f'build-{name}.cmd')
        with open(cmdf, 'w', newline='') as f:
            f.write(vs_cmd_script([f'cl /nologo /O2 /W3 /Fe:{name}-{tag}.exe {name}.c ws2_32.lib '
                                   '|| exit /b 2']))
        upload(host, [src, cmdf], tools)
        shutil.rmtree(tmp, ignore_errors=True)
        rc, out = ps(host, f'''Set-Location {psq(tools)}
cmd.exe /c "build-{name}.cmd > build-{name}.log 2>&1"
if ($LASTEXITCODE -ne 0) {{ Get-Content build-{name}.log -Tail 20; exit 1 }}''', check=False,
                     capture=True)
        if rc:
            print(out)
            die(f'compiling {name}.c on Windows failed')
    return host, exe


def run_windows(host, exe, argv):
    """runs a Windows program (a full path, or a name found in the Windows PATH) with arguments;
    returns its exit code (its output passes through)"""
    if host == LOCAL:
        path = wslpath(exe) if ('\\' in exe or ':' in exe) else shutil.which(exe)
        if not path:
            die(f'{exe} not found on the Windows side')
        return subprocess.run([path, *argv], stdin=subprocess.DEVNULL, check=False,
                              cwd=os.path.dirname(powershell_exe())).returncode
    rc, _ = ps(host, f"& {psq(exe)} {' '.join(psq(a) for a in argv)}\nexit $LASTEXITCODE",
               check=False)
    return rc


def cmd_net(args):
    host, exe = win_tool(args, 'vbs-net')
    sys.exit(run_windows(host, exe, args.args))


def cmd_tls_client(args):
    """vbs-tls-client (scripts/vbs/win/vbs-tls-client.c) on Windows; `--verifier DIR.vbs` names a
    build folder here and becomes the signed image in its Windows folder"""
    host, exe = win_tool(args, 'vbs-tls-client')
    argv = list(args.args)
    for i, a in enumerate(argv[:-1]):
        if a == '--verifier' and os.path.isdir(argv[i + 1]):
            b = Build(argv[i + 1])
            st = b.load()
            if not st or not st.get('windows_dir'):
                die(f'{argv[i + 1]} is not signed on Windows yet')
            argv[i + 1] = st['windows_dir'] + '\\' + b.name + '.dll'
    sys.exit(run_windows(host, exe, argv))


def cmd_win(args):
    sys.exit(run_windows(windows_host(args), args.program, args.args))


def cmd_verify(args):
    b = find_package(args.target)
    st = b.load()
    if not st or not st.get('signed'):
        die(f'{b.dir} is not signed yet')
    host = setting(args, 'windows', 'GRAMINE_VBS_WINDOWS', st.get('windows'))
    windir = setting(args, 'windows_dir', 'GRAMINE_VBS_WINDOWS_DIR', st.get('windows_dir'))
    extra = ' '.join(psq(x) for x in args.checks)
    report = args.report
    if ':' not in report and not report.startswith('\\\\'):    # relative: below the host root
        report = windir + '\\root\\' + report.replace('/', '\\')
    rc, _ = ps(host, f'''
Set-Location {psq(windir)}
& .\\pal_vbs_host.exe {psq(b.name + '.dll')} 1 verify {psq(report)} {extra} 2>&1 |
    Where-Object {{ $_ -notmatch '^\\[host\\]' }} | ForEach-Object {{ "$_" }}
exit $LASTEXITCODE
''', check=False)
    sys.exit(rc)


def cmd_setup_headers(args):
    host = windows_host(args)
    hdr = setting(args, 'headers', 'GRAMINE_VBS_HEADERS',
                  os.path.expanduser('~/.cache/gramine-vbs/winhdr'))
    work = windows_dir(args, host, 'headers', explicit=getattr(args, 'cmd', '') == 'setup-headers')
    log(f'collecting the Windows SDK and MSVC headers on {host} (in {work})')
    rc, out = ps(host, f'$t = {psq(work)}\n' + r'''
$vs = & "${env:ProgramFiles(x86)}\Microsoft Visual Studio\Installer\vswhere.exe" -latest -products * -property installationPath
if (-not $vs) { 'no Visual Studio found'; exit 1 }
$vc = Get-ChildItem "$vs\VC\Tools\MSVC" | Sort-Object Name | Select-Object -Last 1
$kits = "${env:ProgramFiles(x86)}\Windows Kits\10\Include"
$sdk = Get-ChildItem $kits | Where-Object { Test-Path "$($_.FullName)\um\winenclave.h" } | Sort-Object Name | Select-Object -Last 1
if (-not $sdk) { 'no Windows SDK with winenclave.h found'; exit 1 }
Remove-Item -Recurse -Force "$t\sdk", "$t\vc" -ErrorAction SilentlyContinue
New-Item -ItemType Directory -Force -Path "$t\sdk", "$t\vc" | Out-Null
foreach ($s in 'um', 'shared', 'ucrt') { Copy-Item -Recurse "$($sdk.FullName)\$s" "$t\sdk\$s" }
Copy-Item -Recurse "$($vc.FullName)\include" "$t\vc\include"
tar.exe -C $t -czf "$t\winhdr.tgz" sdk vc
Remove-Item -Recurse -Force "$t\sdk", "$t\vc"
"SDK $($sdk.Name), MSVC $($vc.Name)"
Write-Output "$t\winhdr.tgz"
''', capture=True)
    lines = out.strip().splitlines()
    log(lines[-2])
    os.makedirs(hdr, exist_ok=True)
    tgz = os.path.join(hdr, 'winhdr.tgz')
    download(host, lines[-1].strip(), tgz)
    subprocess.run(['tar', '-C', hdr, '-xzf', tgz], check=True)
    os.remove(tgz)
    ps(host, f'Remove-Item -Force {psq(lines[-1].strip())}', capture=True)
    log(f'headers in {hdr}')


def tools_env():
    """Re-executes with the user-level build tools of `wsl-setup.sh user` (env.sh) in the
    environment, so that make and scripts can call gramine-vbs directly."""
    tools = os.environ.get('GRAMINE_VBS_TOOLS',
                           os.path.expanduser('~/.local/share/gramine-vbs/tools'))
    envsh = os.path.join(tools, 'env.sh')
    if os.path.isfile(envsh) and not os.environ.get('GRAMINE_VBS_TOOLS_ENV'):
        os.environ['GRAMINE_VBS_TOOLS_ENV'] = '1'
        os.execvp('sh', ['sh', '-c', '. "$0"; exec "$@"', envsh, sys.executable,
                         os.path.abspath(__file__), *sys.argv[1:]])


def main():
    tools_env()
    ap = argparse.ArgumentParser(prog='gramine-vbs', description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest='cmd', required=True)

    def common(p, build=False, windows=True):
        if build:
            p.add_argument('--runtime')
            p.add_argument('--headers')
        if windows:
            p.add_argument('--windows')
            p.add_argument('--windows-dir')
            p.add_argument('--cert-name')

    p = sub.add_parser('build')
    p.add_argument('target', metavar='manifest')
    p.add_argument('-o', '--output', help='build directory (default: <manifest name>.vbs)')
    p.add_argument('--no-sign', action='store_true', help='only the Linux side')
    common(p, build=True)
    p = sub.add_parser('sign')
    p.add_argument('target', metavar='manifest|build-dir')
    common(p)
    p = sub.add_parser('run')
    p.add_argument('target', metavar='manifest|build-dir')
    p.add_argument('--threads', default=0, help='enclave threads (0: as signed)')
    p.add_argument('--root', help='host root folder on Windows (default <windows dir>\\root)')
    p.add_argument('-v', '--verbose', action='store_true', help='show the host and runtime lines')
    p.add_argument('args', nargs='*', help='application arguments (after --)')
    common(p, build=True)
    p = sub.add_parser('verify')
    p.add_argument('target', metavar='manifest|build-dir')
    p.add_argument('report', help='the report file on Windows')
    p.add_argument('checks', nargs=argparse.REMAINDER,
                   help='verifier options: --user-data HEX, --same-image, --unique-id HEX, ...')
    common(p)
    p = sub.add_parser('setup-headers')
    p.add_argument('--headers')
    p.add_argument('--windows')
    p.add_argument('--windows-dir', help='work folder on Windows (default '
                   '%%USERPROFILE%%\\gramine-vbs\\headers)')

    p = sub.add_parser('stop')
    p.add_argument('target', metavar='manifest|build-dir')
    common(p)
    p = sub.add_parser('manifest')
    p.add_argument('-D', '--define', action='append', default=[], metavar='KEY=VALUE')
    p.add_argument('template')
    p.add_argument('out', nargs='?')
    sub.add_parser('runtime')
    p = sub.add_parser('check')
    common(p)
    p = sub.add_parser('net')
    p.add_argument('args', nargs=argparse.REMAINDER, help='wait|req|redis|bench ...')
    common(p)
    p = sub.add_parser('tls-client')
    p.add_argument('args', nargs=argparse.REMAINDER,
                   help='PORT --verifier DIR.vbs [checks] [action] (vbs-tls-client.c)')
    common(p)
    p = sub.add_parser('win')
    p.add_argument('program')
    p.add_argument('args', nargs=argparse.REMAINDER)
    common(p)

    # `gramine-vbs <program> [args]`: run the packaged program, like `gramine-vm <program>`
    argv = sys.argv[1:]
    if argv and argv[0] not in sub.choices and not argv[0].startswith('-'):
        argv = ['run', argv[0], '--', *argv[1:]]
    args = ap.parse_args(argv)
    {'build': cmd_build, 'sign': lambda a: cmd_sign(a), 'run': cmd_run, 'verify': cmd_verify,
     'setup-headers': cmd_setup_headers, 'stop': cmd_stop, 'manifest': cmd_manifest,
     'runtime': cmd_runtime, 'check': cmd_check, 'net': cmd_net, 'tls-client': cmd_tls_client,
     'win': cmd_win}[args.cmd](args)


if __name__ == '__main__':
    main()

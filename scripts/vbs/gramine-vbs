    p.add_argument('--windows-dir', help='work folder on Windows (default '
                   '%%USERPROFILE%%\\gramine-vbs\\headers)')

    args = ap.parse_args()
    {'build': cmd_build, 'sign': lambda a: cmd_sign(a), 'run': cmd_run, 'verify': cmd_verify,
     'setup-headers': cmd_setup_headers}[args.cmd](args)



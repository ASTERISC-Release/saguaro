# SQLite manifest for a Windows VBS enclave (`make VBS=1`, dev docs: vbs-enclave/manual.md): the counterpart of
# manifest.template. The shell is built from the amalgamation with the vbs gcc (vbs-build/sqlite3, a
# static PIE) and runs one command per enclave: `sqlite3 DB SQL`, the arguments come from the command
# line (vbs-check.sh), so that the scripts run with `.read` (the enclave has no console input).

loader.entrypoint = "file:/libsysdb.so"
libos.entrypoint = "/sqlite3"
loader.log_level = "{{ log_level }}"

loader.insecure__use_cmdline_argv = true

# SQLite creates its journal next to the database: both live in the host folder /db/
vbs.allowed_files = [ "/db/" ]

loader.env.HOME = "/"

fs.root.uri = "file:/"
# no run-time code generation in a VBS enclave
sys.rewrite_syscalls = false

vbs.debug = false
# one process, one thread; the database is in the host folder
vbs.enclave_size = "256M"
vbs.max_threads = 4

vbs.packed_files = [
  { path = "/sqlite3", uri = "file:vbs-build/sqlite3" },
  { path = "/scripts/create.sql", uri = "file:scripts/create.sql" },
  { path = "/scripts/update.sql", uri = "file:scripts/update.sql" },
  { path = "/scripts/select.sql", uri = "file:scripts/select.sql" },
]

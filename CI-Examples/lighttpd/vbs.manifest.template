# lighttpd manifest for a Windows VBS enclave (`make VBS=1`, Documentation/vbs.md): the counterpart
# of lighttpd.manifest.template. lighttpd (built with the vbs gcc, prefix /lighttpd), its modules
# (loaded with dlopen: packed objects), its configuration and the test files are packed into the
# signed image.

loader.entrypoint = "file:/libsysdb.so"
libos.entrypoint = "/lighttpd/sbin/lighttpd"
loader.log_level = "{{ log_level }}"

loader.argv = ["lighttpd", "-D", "-m", "/lighttpd/lib", "-f", "/lighttpd/conf/lighttpd-vbs.conf"]
loader.env.LD_LIBRARY_PATH = "{{ arch_libdir }}:/lighttpd/lib"

fs.root.uri = "file:/"
fs.mounts = [
  { type = "tmpfs", path = "/var/tmp" },
]
# no run-time code generation in a VBS enclave
sys.rewrite_syscalls = false

vbs.debug = false
vbs.enclave_size = "256M"
vbs.max_threads = 8

vbs.packed_files = [
  { path = "/lighttpd", uri = "file:vbs-build/root/lighttpd", exclude = [ "*.la", "share/" ] },
{% for lib in [vbs.ldso, "libc.so.6", "libm.so.6"] %}
  { path = "{{ arch_libdir }}/{{ lib }}", uri = "file:{{ vbs.sysroot }}/usr/lib/{{ lib }}" },
{% endfor %}
]

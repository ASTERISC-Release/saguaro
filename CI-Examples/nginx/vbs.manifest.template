# NGINX manifest for a Windows VBS enclave (`make VBS=1`, Documentation/vbs.rst): the counterpart of
# nginx.manifest.template. NGINX (built with the vbs gcc, prefix /nginx), its configuration
# (nginx-vbs.conf: one process, one worker, HTTP) and the static files are packed into the signed
# image; /tmp is an in-enclave tmpfs for the pid file and temporary files.

loader.entrypoint = "file:/libsysdb.so"
libos.entrypoint = "/nginx/sbin/nginx"
loader.log_level = "{{ log_level }}"

loader.argv = ["nginx", "-c", "conf/nginx-vbs.conf"]
loader.env.LD_LIBRARY_PATH = "{{ arch_libdir }}"

# as in nginx.manifest.template: a non-root user, so that NGINX does not try to drop privileges
loader.uid = 1000
loader.gid = 1000

fs.root.uri = "file:/"
fs.mounts = [
  { type = "tmpfs", path = "/tmp" },
]
# no run-time code generation in a VBS enclave
sys.rewrite_syscalls = false

vbs.debug = false
vbs.enclave_size = "512M"
vbs.max_threads = 8

vbs.packed_files = [
  { path = "/nginx", uri = "file:vbs-build/root/nginx" },
{% for lib in ["ld-linux-aarch64.so.1", "libc.so.6", "libm.so.6"] %}
  { path = "{{ arch_libdir }}/{{ lib }}", uri = "file:{{ vbs.sysroot }}/usr/lib/{{ lib }}" },
{% endfor %}
]

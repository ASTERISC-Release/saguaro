# SuperTuxKart under saguaro-direct on the host GPU (dev docs: graphics-direct/).
# Insecure by design: the application can submit work to the GPU and talk to the X server directly
# (see the insecure__ keys below and Documentation/manifest-keys.md).

libos.entrypoint = "/supertuxkart/stk-build/stk-code/cmake_build/bin/supertuxkart"

loader.log_level = "{{ log_level }}"
loader.insecure__use_host_env = true
{% if startup_probe is defined and startup_probe %}
loader.argv = ["supertuxkart", "--race-now", "--benchmark", "--profile-time={{ profile_time }}", "--screensize=1920x1080", "--windowed", "--seed=11", "--track=abyss", "--kart=konqi"]
{% else %}
loader.argv = ["supertuxkart", "--race-now", "--screensize=1920x1080", "--seed=11", "--track=abyss", "--kart=konqi"]
{% endif %}

loader.env.LD_LIBRARY_PATH = "/lib:/usr/lib:/usr{{ arch_libdir }}:{{ arch_libdir }}"
{% if preload|string != "0" %}
# The preload library in its native ("process") mode: EGL on GBM, presentation with DRI3.
loader.env.LD_PRELOAD = "/libgraphics.so"
loader.env.EGL_SAGUARO = "0"
loader.env.EGL_DISCRETE = "{{ egl_discrete }}"
loader.env.GBM_BACKEND = "dri"
{% endif %}
loader.env.HOME = "/root"
loader.env.XDG_CONFIG_HOME = "/root/.config"
loader.env.XDG_DATA_HOME = "/root/.local/share"
loader.env.XDG_CACHE_HOME = "/root/.cache"
loader.env.USER = "root"
loader.env.DISPLAY = ":{{ display }}"
loader.env.vblank_mode = "0"
# the same for the NVIDIA driver
loader.env.__GL_SYNC_TO_VBLANK = "0"
loader.env.SUPERTUXKART_DATADIR = "/supertuxkart/stk-build/stk-code/"
loader.env.ALSOFT_DRIVERS = "null"
loader.env.SDL_AUDIODRIVER = "dummy"
loader.env.SDL_VIDEODRIVER = "x11"
loader.env.PULSE_SERVER = "none"
loader.env.PIPEWIRE_REMOTE = "none"

sys.stack.size = "32M"
# `timeout` and other stops by SIGTERM: let it through once so the program can exit cleanly
sys.enable_sigterm_injection = true

# GPU ioctls go to the host unchanged (Linux PAL only)
sys.insecure__allow_raw_device_ioctl = true
# the X server's socket, with fd passing (dma-bufs and fences for DRI3)
sys.insecure__host_unix_sockets = ["/tmp/.X11-unix/X{{ display }}"]

fs.mounts = [
{% if preload|string != "0" %}
  { path = "/libgraphics.so", uri = "file:{{ saguaro.libgraphics }}" },
{% endif %}
  { path = "/lib", uri = "file:{{ saguaro.runtimedir() }}" },
  { path = "/usr", type = "chroot", uri = "file:/usr" },
  { path = "/etc/ld.so.cache", uri = "file:/etc/ld.so.cache" },
  { path = "/etc/localtime", uri = "file:/etc/localtime" },
  { path = "/dev/dri", type = "chroot", uri = "file:/dev/dri" },
{% if nvidia|string == "1" %}
  # the NVIDIA proprietary driver (dev docs: graphics-aarch64/)
  { path = "/dev/nvidiactl", uri = "dev:/dev/nvidiactl" },
  { path = "/dev/nvidia0", uri = "dev:/dev/nvidia0" },
  { path = "/dev/nvidia-modeset", uri = "dev:/dev/nvidia-modeset" },
  { path = "/proc/driver/nvidia", type = "chroot", uri = "file:/proc/driver/nvidia" },
{% endif %}
  # libxshmfence's fences when there is no memfd_create
  { path = "/dev/shm", type = "chroot", uri = "file:/dev/shm" },
  { path = "/sys", type = "chroot", uri = "file:/sys", host_symlinks = true },
  # the game, its assets, and its configuration, data and shader-cache directories
  { path = "/supertuxkart", type = "chroot", uri = "file:{{ stk_dir }}" },
  { path = "/supertuxkart/stk-build/stk-code/stk-assets", type = "chroot", uri = "file:{{ stk_dir }}/stk-build/stk-assets" },
  { path = "/root/.config", type = "chroot", uri = "file:{{ env.HOME }}/.config" },
  { path = "/root/.local/share", type = "chroot", uri = "file:{{ env.HOME }}/.local/share" },
  { path = "/root/.cache", type = "chroot", uri = "file:{{ env.HOME }}/.cache" },
]

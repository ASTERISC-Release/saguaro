 }   // update
 
+//-----------------------------------------------------------------------------
+void ProfileWorld::recordFrameTime()
+{
+    const std::chrono::steady_clock::time_point current_time =
+        std::chrono::steady_clock::now();
+    const std::chrono::duration<double> frame_time =
+        current_time - m_last_frame_time;
+
+    if (m_frame_count > 0 && frame_time.count() > 0.0)
+        m_frame_times.push_back(frame_time.count());
+
+    m_last_frame_time = current_time;
+}   // recordFrameTime
+
+//-----------------------------------------------------------------------------
+/** Counts rendered frames for profile FPS statistics. */
+void ProfileWorld::updateGraphics(float dt)
+{
+    StandardRace::updateGraphics(dt);
+    recordFrameTime();
+    m_frame_count++;
+}   // updateGraphics

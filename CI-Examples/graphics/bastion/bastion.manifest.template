# Bastion (Supergiant Games, the GOG.com Linux build: MonoKickstart, FNA on SDL2 and OpenGL, FMOD)
# under gramine-vm with the Tirith graphics redirection (x86_64). See README.md in this directory.

libos.entrypoint = "/bastion/Bastion.bin.x86_64"
fs.start_dir = "/bastion"

sys.stack.size = "32M"
{% if multiproc|string == "1" %}
# Processes in the VM (experimental, dev docs: vm-multiproc/): FMOD runs
# `sh -c "pulseaudio --check"`.
sys.experimental__multiprocess = true
{% endif %}
libos.check_invalid_pointers = false
{% if shared_input|string != "0" %}
# Key, button and pointer events come through the shared-memory ring in the comm page; build with
# SHARED_INPUT=0 to receive them over the X connection instead (see
# dev docs: graphics/running.md).
sys.experimental__shared_input_ring = true
{% endif %}

loader.log_level = "{{ log_level }}"
loader.insecure__use_host_env = true
loader.argv = ["Bastion.bin.x86_64", "-windowed"]

# The game's own libraries (Mono, FMOD, MojoShader) are found through /bastion/lib64.
loader.env.LD_LIBRARY_PATH = "/bastion/lib64:/lib:/usr/lib:/usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu"
loader.env.LD_PRELOAD = "/libgraphics.so"
loader.env.HOME = "/root"
loader.env.USER = "root_user"
loader.env.DISPLAY = "2:0"
vm.net.direct_vsock_ports = [6000]
loader.env.IVSHMEM_GRAMINE_VM = "1"
loader.env.HOST_SDL_WINDOW = "1"
loader.env.GALLIUM_THREAD = "0"
loader.env.GLIBC_TUNABLES = "glibc.pthread.rseq=0"
loader.env.__GL_SYNC_TO_VBLANK = "0"
loader.env.vblank_mode = "0"
# No sound device in the guest. FMOD (not SDL) plays the audio and probes PulseAudio by running a
# shell command, which needs fork, so it fails in the single-process VM; whether the game then runs
# silently is part of what this example tests.
loader.env.ALSOFT_DRIVERS = "null"
loader.env.SDL_AUDIODRIVER = "dummy"
loader.env.PULSE_SERVER = "none"
loader.env.PIPEWIRE_REMOTE = "none"
loader.env.GBM_BACKEND = "dri"
loader.env.EGL_GRAMINE = "1"
loader.env.EGL_DISCRETE = "0"
loader.env.EGL_SHARED_INPUT = "{{ '0' if shared_input|string == '0' else '1' }}"

fs.mounts = [
  { path = "/lib", uri = "file:{{ gramine.runtimedir() }}" },
  { path = "/libgraphics.so", uri = "file:{{ gramine.libgraphics }}" },

  # Stock Mesa, SDL and X libraries from the host root
  { path = "/usr", type = "chroot", uri = "file:/usr" },

  { path = "/etc/ld.so.cache", uri = "file:/etc/ld.so.cache" },
{% if multiproc|string == "1" %}
  # /bin/sh for FMOD's probe
  { path = "/bin", uri = "file:/bin" },
{% endif %}
  { path = "/sys", type = "chroot", uri = "file:/sys" },
  { path = "/sys/dev", type = "chroot", uri = "file:/sys/dev" },
  { path = "/sys/devices", type = "chroot", uri = "file:/sys/devices" },
  { path = "/sys/bus/pci", type = "chroot", uri = "file:/sys/bus/pci" },

  # The game, unpacked by setup-bastion.sh
  { path = "/bastion", type = "chroot", uri = "file:{{ game_dir }}" },
{% if system_sdl|string != "0" %}
  # The host's SDL2 instead of the bundled one: the graphics preload library interposes SDL calls of
  # the system library. Build with SYSTEM_SDL=0 to try the game's own.
  { path = "/bastion/lib64/libSDL2-2.0.so.0", uri = "file:/usr/lib/x86_64-linux-gnu/libSDL2-2.0.so.0" },
{% endif %}

  # Save games and settings go to their own host directory, not to the host's home. The guest paths
  # under /root are fixed: the LibOS forwards /root/.cache to the host by that name.
  { path = "/root/.local/share", type = "chroot", uri = "file:{{ data_dir }}/share" },
  { path = "/root/.config", type = "chroot", uri = "file:{{ data_dir }}/config" },
  { path = "/root/.cache", type = "chroot", uri = "file:{{ home }}/.cache" },
]

sgx.debug = true
sgx.edmm_enable = {{ 'true' if env.get('EDMM', '0') == '1' else 'false' }}

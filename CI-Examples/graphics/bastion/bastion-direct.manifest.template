# Bastion under gramine-direct on the host GPU (Documentation/devel/graphics-direct/). Insecure by
# design: the application can submit work to the GPU and talk to the X server directly (see the
# insecure__ keys below and Documentation/manifest-syntax.rst).

libos.entrypoint = "/bastion/Bastion.bin.x86_64"
fs.start_dir = "/bastion"

loader.log_level = "{{ log_level }}"
loader.insecure__use_host_env = true
loader.argv = ["Bastion.bin.x86_64", "-windowed"]

loader.env.LD_LIBRARY_PATH = "/bastion/lib64:/lib:/usr/lib:/usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu"
{% if preload|string != "0" %}
# The preload library in its native ("process") mode: EGL on GBM, presentation with DRI3.
loader.env.LD_PRELOAD = "/libgraphics.so"
loader.env.EGL_GRAMINE = "0"
loader.env.EGL_DISCRETE = "{{ egl_discrete }}"
loader.env.GBM_BACKEND = "dri"
{% endif %}
loader.env.HOME = "/root"
loader.env.USER = "root_user"
loader.env.DISPLAY = ":{{ display }}"
loader.env.vblank_mode = "0"
loader.env.ALSOFT_DRIVERS = "null"
loader.env.SDL_AUDIODRIVER = "dummy"
loader.env.PULSE_SERVER = "none"
loader.env.PIPEWIRE_REMOTE = "none"

sys.stack.size = "32M"
# `timeout` and other stops by SIGTERM: let it through once so the program can exit cleanly
sys.enable_sigterm_injection = true

# GPU ioctls go to the host unchanged (Linux PAL only)
sys.insecure__allow_raw_device_ioctl = true
# the X server's socket, with fd passing (dma-bufs and fences for DRI3)
sys.insecure__host_unix_sockets = ["/tmp/.X11-unix/X{{ display }}"]

fs.mounts = [
{% if preload|string != "0" %}
  { path = "/libgraphics.so", uri = "file:{{ gramine.libgraphics }}" },
{% endif %}
  { path = "/lib", uri = "file:{{ gramine.runtimedir() }}" },
  { path = "/usr", type = "chroot", uri = "file:/usr" },
  { path = "/etc/ld.so.cache", uri = "file:/etc/ld.so.cache" },
  { path = "/dev/dri", type = "chroot", uri = "file:/dev/dri" },
  # memfd_create and libxshmfence back their files here
  { path = "/dev/shm", type = "chroot", uri = "file:/dev/shm" },
  { path = "/sys", type = "chroot", uri = "file:/sys", host_symlinks = true },
  # The game, unpacked by setup-bastion.sh
  { path = "/bastion", type = "chroot", uri = "file:{{ game_dir }}" },
{% if system_sdl|string != "0" %}
  # The host's SDL2 instead of the bundled one (SYSTEM_SDL=0 keeps the game's own)
  { path = "/bastion/lib64/libSDL2-2.0.so.0", uri = "file:/usr/lib/x86_64-linux-gnu/libSDL2-2.0.so.0" },
{% endif %}
  # Save games and settings in their own host directory
  { path = "/root/.local/share", type = "chroot", uri = "file:{{ data_dir }}/share" },
  { path = "/root/.config", type = "chroot", uri = "file:{{ data_dir }}/config" },
  { path = "/root/.cache", type = "chroot", uri = "file:{{ home }}/.cache" },
]

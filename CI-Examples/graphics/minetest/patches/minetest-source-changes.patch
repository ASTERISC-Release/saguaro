+inline unsigned long sg_rdtscp(void)
+{
+	unsigned int lo, hi;
+	__asm__ volatile("rdtscp" : "=a" (lo), "=d" (hi)::"memory");
+	return ((unsigned long)hi << 32) | lo;
+}
+
+namespace
+{
+
+constexpr long long FPS_PRINT_PERIOD_US = 60LL * 1000LL * 1000LL;
+
+double frameTimeToFps(double frame_time_us)
+{
+	return frame_time_us > 0.0 ? 1000.0 * 1000.0 / frame_time_us : 0.0;
+}
+
+double onePercentLowFps(std::vector<int> frametimes)
+{
+	if (frametimes.empty())
+		return 0.0;
+
+	std::sort(frametimes.begin(), frametimes.end());
+	size_t slow_frame_count = std::max<size_t>(1, (frametimes.size() + 99) / 100);
+	double slow_frame_total = 0.0;
+
+	for (size_t i = frametimes.size() - slow_frame_count; i < frametimes.size(); i++)
+		slow_frame_total += frametimes[i];
+
+	return frameTimeToFps(slow_frame_total / slow_frame_count);
+}
+
+void printFrameStats(const std::vector<int> &frametimes,
+		const std::vector<unsigned long> &frametimes_cycles)
+{
+	double avg = 0.0;
+	for (int frametime : frametimes)
+		avg += frametime;
+	avg /= frametimes.size();
+
+	int max_frame_time = *std::max_element(frametimes.begin(), frametimes.end());
+	int min_frame_time = *std::min_element(frametimes.begin(), frametimes.end());
+
+	double avg_c = 0.0;
+	for (unsigned long frametime_cycle : frametimes_cycles)
+		avg_c += frametime_cycle;
+	avg_c /= frametimes_cycles.size();
+
+	unsigned long max_frame_cycles = *std::max_element(
+			frametimes_cycles.begin(), frametimes_cycles.end());
+	unsigned long min_frame_cycles = *std::min_element(
+			frametimes_cycles.begin(), frametimes_cycles.end());
+
+	printf("FPS: avg %.2f, 1%% low %.2f, min %.2f\n",
+			frameTimeToFps(avg), onePercentLowFps(frametimes),
+			frameTimeToFps(max_frame_time));
+	printf("Frame time: avg %.3f ms, max %.3f ms, min %.3f ms\n",
+			0.001f * avg, 0.001f * max_frame_time, 0.001f * min_frame_time);
+	printf("Cycles: avg %.0f, max %lu, min %lu\n",
+			avg_c, max_frame_cycles, min_frame_cycles);
+}
+
+}

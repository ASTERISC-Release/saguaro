+long long
+Sys_Microseconds(void)
+{
+#ifdef __APPLE__
+	// OSX didn't have clock_gettime() until recently, so use Mach's clock_get_time()
+	// instead. fortunately its mach_timespec_t seems identical to POSIX struct timespec
+	// so lots of code can be shared
+	clock_serv_t cclock;
+	mach_timespec_t now;
+	static mach_timespec_t first;
+
+	host_get_clock_service(mach_host_self(), SYSTEM_CLOCK, &cclock);
+	clock_get_time(cclock, &now);
+	mach_port_deallocate(mach_task_self(), cclock);
+
+#else // not __APPLE__ - other Unix-likes will hopefully support clock_gettime()
+
+	struct timespec now;
+	static struct timespec first;
+#ifdef _POSIX_MONOTONIC_CLOCK
+	clock_gettime(CLOCK_MONOTONIC, &now);
+#else
+	clock_gettime(CLOCK_REALTIME, &now);
+#endif
+
+#endif // not __APPLE__
+
+	if(first.tv_sec == 0)
+	{
+		long long nsec = now.tv_nsec;
+		long long sec = now.tv_sec;
+		// set back first by 1ms so neither this function nor Sys_Milliseconds()
+		// (which calls this) will ever return 0
+		nsec -= 1000000;
+		if(nsec < 0)
+		{
+			nsec += 1000000000ll; // 1s in ns => definitely positive now
+			--sec;
+		}
+
+		first.tv_sec = sec;
+		first.tv_nsec = nsec;
+	}
+
+	long long sec = now.tv_sec - first.tv_sec;
+	long long nsec = now.tv_nsec - first.tv_nsec;
+
+	if(nsec < 0)
+	{
+		nsec += 1000000000ll; // 1s in ns
+		--sec;
+	}
+
+	return sec*1000000ll + nsec/1000ll;
+}
+void
+frame_stats(void)
+{
+	long long newtime;
+	unsigned long newtime_cycles;
+	static long long oldtime = 0;
+	static unsigned long oldtime_cycles = 0;
+	static long long next_print_time = 0;
+	static size_t elapsed_minutes = 0;
+	static bool printed_once = false;
+	static std::vector<int> minute_frametimes;
+	static std::vector<unsigned long> minute_frametimes_cycles;
+	static std::vector<int> lifetime_frametimes;
+	static std::vector<unsigned long> lifetime_frametimes_cycles;
+
+	newtime = Sys_Microseconds();
+	newtime_cycles = sg_rdtscp();
+
+	if (oldtime == 0) {
+		oldtime = newtime;
+		oldtime_cycles = newtime_cycles;
+		next_print_time = newtime + FPS_PRINT_PERIOD_US;
+		return;
+	}
+
+	int frametime = (int)(newtime - oldtime);
+	unsigned long frametime_cycles = newtime_cycles - oldtime_cycles;
+	oldtime = newtime;
+	oldtime_cycles = newtime_cycles;
+
+	if (frametime <= 0)
+		return;
+
+	if (minute_frametimes.capacity() == 0) {
+		minute_frametimes.reserve(360000);
+		minute_frametimes_cycles.reserve(360000);
+		lifetime_frametimes.reserve(360000);
+		lifetime_frametimes_cycles.reserve(360000);
+	}
+
+	minute_frametimes.push_back(frametime);
+	minute_frametimes_cycles.push_back(frametime_cycles);
+	lifetime_frametimes.push_back(frametime);
+	lifetime_frametimes_cycles.push_back(frametime_cycles);
+
+	if (newtime < next_print_time)
+		return;
+
+	do {
+		next_print_time += FPS_PRINT_PERIOD_US;
+		elapsed_minutes++;
+	} while (newtime >= next_print_time);
+
+	if (printed_once)
+		printf("\n");
+
+	printf("STATS FOR LAST MINUTE\n");
+	printFrameStats(minute_frametimes, minute_frametimes_cycles);
+	printf("\n");
+	printf("STATS FOR LIFETIME (%zu MINUTES)\n", elapsed_minutes);
+	printFrameStats(lifetime_frametimes, lifetime_frametimes_cycles);
+	fflush(stdout);
+
+	minute_frametimes.clear();
+	minute_frametimes_cycles.clear();
+	printed_once = true;
+}
 

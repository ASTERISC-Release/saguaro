# Hello World manifest file example

libos.entrypoint = "/helloworld"
loader.log_level = "{{ log_level }}"

loader.env.LD_LIBRARY_PATH = "/lib"

fs.mounts = [
  { path = "/lib", uri = "file:{{ saguaro.runtimedir() }}" },
  { path = "/helloworld", uri = "file:helloworld" },
]

sgx.debug = true
# the program maps 512 MiB (helloworld.c); the default enclave size is 256M
sgx.enclave_size = "1G"
sgx.edmm_enable = {{ 'true' if env.get('EDMM', '0') == '1' else 'false' }}

sgx.trusted_files = [
  "file:helloworld",
  "file:{{ saguaro.runtimedir() }}/",
]

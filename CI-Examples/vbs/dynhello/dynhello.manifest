# A dynamically linked program in a Windows VBS enclave (Documentation/vbs.rst): the program, the
# dynamic loader and libc are packed, and libm.so.6 for its run-time dlopen. The source is the
# vbs PAL's test pal/src/host/vbs/test/dynhello/dynhello.c. gramine-vbs run dynhello.manifest
loader.entrypoint = "file:/libsysdb.so"
libos.entrypoint = "/dynhello"
loader.log_level = "error"
loader.env.LD_LIBRARY_PATH = "/usr/lib"
fs.root.uri = "file:/"
sys.rewrite_syscalls = false

vbs.debug = false
vbs.max_threads = 4
vbs.build = "$VBS_CC_DYNAMIC -o dynhello $GRAMINE_REPO/pal/src/host/vbs/test/dynhello/dynhello.c"
vbs.packed_files = [
  { path = "/dynhello", uri = "file:dynhello" },
  { path = "/usr/lib/ld-linux-aarch64.so.1", uri = "file:../../../build-vbs-glibc/usr/lib/ld-linux-aarch64.so.1" },
  { path = "/usr/lib/libc.so.6", uri = "file:../../../build-vbs-glibc/usr/lib/libc.so.6" },
  { path = "/usr/lib/libm.so.6", uri = "file:../../../build-vbs-glibc/usr/lib/libm.so.6" },
]

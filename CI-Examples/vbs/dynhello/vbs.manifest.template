# A dynamically linked program in a Windows VBS enclave (dev docs: vbs-enclave/manual.md): the program, the
# dynamic loader and libc are packed, and libm.so.6 for its run-time dlopen. The source is the
# vbs PAL's test pal/src/host/vbs/test/dynhello/dynhello.c. make VBS=1; gramine-vbs dynhello
loader.entrypoint = "file:/libsysdb.so"
libos.entrypoint = "/dynhello"
loader.log_level = "error"
loader.env.LD_LIBRARY_PATH = "/usr/lib"
fs.root.uri = "file:/"
sys.rewrite_syscalls = false

vbs.debug = false
vbs.max_threads = 4
vbs.build = "$VBS_CC_DYNAMIC -o dynhello $SAGUARO_REPO/pal/src/host/vbs/test/dynhello/dynhello.c"
vbs.packed_files = [
  { path = "/dynhello", uri = "file:dynhello" },
  { path = "/usr/lib/{{ vbs.ldso }}", uri = "file:{{ vbs.sysroot }}/usr/lib/{{ vbs.ldso }}" },
  { path = "/usr/lib/libc.so.6", uri = "file:{{ vbs.sysroot }}/usr/lib/libc.so.6" },
  { path = "/usr/lib/libm.so.6", uri = "file:{{ vbs.sysroot }}/usr/lib/libm.so.6" },
]

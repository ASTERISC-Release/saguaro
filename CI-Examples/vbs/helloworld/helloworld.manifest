# Hello world in a Windows VBS enclave (Documentation/vbs.rst): gramine-vbs run helloworld.manifest
# (vbs.build compiles the program for the enclave first: a static PIE against the vbs glibc).
loader.entrypoint = "file:/libsysdb.so"
libos.entrypoint = "/helloworld"
loader.log_level = "error"
fs.root.uri = "file:/"
sys.rewrite_syscalls = false

vbs.debug = false
vbs.max_threads = 4
vbs.build = "$VBS_CC_STATIC -o helloworld helloworld.c"
vbs.packed_files = [
  { path = "/helloworld", uri = "file:helloworld" },
]

# Attestation in a Windows VBS enclave (dev docs: vbs-enclave/manual.md): the program writes user data to
# /dev/attestation/user_report_data and saves the report to the host; `saguaro-vbs verify` checks
# it. vbs.build compiles the program (pal/src/host/vbs/test/attest/attest.c) for the enclave.
#   saguaro-vbs run attest.manifest -- <user data hex>
loader.entrypoint = "file:/libsysdb.so"
libos.entrypoint = "/attest"
loader.insecure__use_cmdline_argv = true  # the user data comes from the command line
loader.log_level = "error"
fs.root.uri = "file:/"
sys.rewrite_syscalls = false

vbs.debug = false
vbs.family_id = "6772616d696e652d7662732d74657374"  # "gramine-vbs-test"
vbs.image_id = "61747465737400000000000000000002"
vbs.isv_svn = 1
vbs.build = "$VBS_CC_STATIC -o attest $SAGUARO_REPO/pal/src/host/vbs/test/attest/attest.c"
vbs.packed_files = [
  { path = "/attest", uri = "file:attest" },
]
# the report goes to <host root>\data\out on Windows
vbs.allowed_files = [ "/data/out/" ]

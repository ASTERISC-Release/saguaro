# CPython in a Windows VBS enclave (dev docs: vbs-enclave/manual.md): make VBS=1; gramine-vbs python
# vbs.build builds CPython 3.12.7 for the enclave once (scripts/vbs/build-python.sh, against the vbs
# glibc, into <repo>/build-vbs-python; later builds reuse it); the paths below are relative to this
# file.
loader.entrypoint = "file:/libsysdb.so"
libos.entrypoint = "/usr/bin/python3.12"
loader.argv = ["/usr/bin/python3.12", "/app/hello.py"]
loader.log_level = "error"
loader.env.LD_LIBRARY_PATH = "/usr/lib"
loader.env.PYTHONDONTWRITEBYTECODE = "1"
loader.env.HOME = "/app"
fs.root.uri = "file:/"
sys.rewrite_syscalls = false

vbs.debug = false
vbs.max_threads = 8
vbs.enclave_size = "512M"
vbs.build = "sh $GRAMINE_REPO/scripts/vbs/build-python.sh --if-needed"
vbs.packed_files = [
  { path = "/usr/bin/python3.12", uri = "file:{{ vbs.python }}/usr/bin/python3.12" },
  # the standard library without its tests, the IDE and Tk parts, and the static library
  { path = "/usr/lib/python3.12", uri = "file:{{ vbs.python }}/usr/lib/python3.12", exclude = [ "config-3.12-*/", "__pycache__/", "test/", "tests/", "idlelib/", "tkinter/", "turtledemo/", "lib2to3/", "ensurepip/", "pydoc_data/", "*.a" ] },
  { path = "/usr/lib/{{ vbs.ldso }}", uri = "file:{{ vbs.sysroot }}/usr/lib/{{ vbs.ldso }}" },
  { path = "/usr/lib/libc.so.6", uri = "file:{{ vbs.sysroot }}/usr/lib/libc.so.6" },
  { path = "/usr/lib/libm.so.6", uri = "file:{{ vbs.sysroot }}/usr/lib/libm.so.6" },
  { path = "/app/hello.py", uri = "file:hello.py" },
]

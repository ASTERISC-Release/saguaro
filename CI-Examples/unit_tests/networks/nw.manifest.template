##############################################
# LibOS Settings
##############################################
libos.entrypoint = "./udp"

##############################################
# Loader
##############################################

# Loader configuration
loader.insecure__use_host_env = true
# loader.log_level = "trace"
# Loader environment overrides
loader.env.LD_LIBRARY_PATH = "/lib:/usr/lib:{{ arch_libdir }}"
loader.env.HOME = "/root"

##############################################
# Core mounts
##############################################
##############################################
# Filesystem Mounts (ALL in one array)
##############################################

fs.mounts = [
  # Core system dirs
  { path = "/lib", uri = "file:{{ saguaro.runtimedir() }}" },
  { path = "/usr/lib", uri = "file:/usr/lib" },
  { path = "{{ arch_libdir }}", uri = "file:{{ arch_libdir }}" },
]
sgx.debug = true
sgx.edmm_enable = {{ 'true' if env.get('EDMM', '0') == '1' else 'false' }}

sgx.trusted_files = [
  "file:./glxg",
  "file:{{ saguaro.runtimedir() }}/",
]


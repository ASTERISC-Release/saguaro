# Manifest of a multi-threading unit test

libos.entrypoint = "/thread-rwlock"
loader.log_level = "{{ log_level }}"
# loader.log_level = "trace"

loader.env.LD_LIBRARY_PATH = "/lib:/usr/lib:/usr/lib/{{ multiarch }}:/lib/{{ multiarch }}"
loader.env.HOME = "/root"
loader.env.USER = "root"

loader.insecure__use_cmdline_argv = true
loader.insecure__use_host_env = true

fs.mounts = [
  # General libraries and hooks
  { path = "/lib", uri = "file:{{ gramine.runtimedir() }}" },
  { path = "/thread-stress", uri = "file:thread-stress" },
]
